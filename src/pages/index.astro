---
import Layout from '../layouts/Layout.astro';
import catalog from '../../data/bmw/catalog-clean-front.json';

const totalGenerations = catalog.generations.length;
const totalChassis = catalog.stats.chassis;
const totalVariants = catalog.stats.totalVariants;
const modelsJson = JSON.stringify(catalog.generations);
---

<Layout title="Carvault — Catálogo y API Pública de Automóviles (BMW Edition)">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-16 pb-20 border-b border-slate-900 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium border border-cyan-500/30 bg-cyan-500/10 text-cyan-300 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
        v1.2 • Vista Frontal Exterior Limpia & Exacta (Sin Piezas Mecánicas)
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-tight">
        Cada coche y modelo desde su <span class="bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-500 bg-clip-text text-transparent">perspectiva frontal</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-400 max-w-3xl mx-auto leading-relaxed">
        Explora la historia automotriz con fotografías limpias de la carrocería completa. Búsqueda exacta por modelo (<span class="text-cyan-300 font-mono">M2</span>, <span class="text-cyan-300 font-mono">320i</span>, <span class="text-cyan-300 font-mono">M3</span>, <span class="text-cyan-300 font-mono">135i</span>), distinciones visuales de chasis y paquetes <span class="text-indigo-400 font-semibold">M Sport</span>.
      </p>

      <!-- Métricas rápidas -->
      <div class="mt-8 flex flex-wrap justify-center gap-6 sm:gap-12 text-slate-300">
        <div class="flex flex-col items-center">
          <span class="text-3xl font-black text-white font-mono">{totalGenerations}</span>
          <span class="text-xs text-slate-500 uppercase tracking-wider mt-1">Modelos & Versiones</span>
        </div>
        <div class="h-10 w-[1px] bg-slate-800 hidden sm:block"></div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-black text-indigo-400 font-mono">{catalog.stats.mPerformance || 37}</span>
          <span class="text-xs text-slate-500 uppercase tracking-wider mt-1">Gama BMW M</span>
        </div>
        <div class="h-10 w-[1px] bg-slate-800 hidden sm:block"></div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-black text-cyan-400 font-mono">{totalChassis}</span>
          <span class="text-xs text-slate-500 uppercase tracking-wider mt-1">Chasis Distintos</span>
        </div>
        <div class="h-10 w-[1px] bg-slate-800 hidden sm:block"></div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-black text-emerald-400 font-mono">173</span>
          <span class="text-xs text-slate-500 uppercase tracking-wider mt-1">Frontales con Foto</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Catálogo Interactivo -->
  <section id="catalog" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Barra de Búsqueda y Filtros -->
    <div class="bg-slate-900/70 p-4 rounded-2xl border border-slate-800/80 backdrop-blur-md mb-10 flex flex-col md:flex-row gap-4 items-center justify-between">
      <div class="relative w-full md:w-96">
        <svg class="w-4 h-4 text-slate-500 absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input 
          id="searchInput"
          type="text" 
          placeholder="Busca modelo (ej. M2, 320i, G87, F87, M3, E46, M Sport...)" 
          class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-10 pr-4 py-2 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500/80 transition-colors font-mono"
        />
      </div>

      <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
        <button data-filter="all" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-cyan-500 text-slate-950 transition-all">
          Todos ({totalGenerations})
        </button>
        <button data-filter="m-performance" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 hover:bg-indigo-500/30 transition-all flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
          BMW M Motorsport ({catalog.stats.mPerformance || 37})
        </button>
        <button data-filter="production" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all">
          Producción Estándar
        </button>
        <button data-filter="prototypes" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all">
          Conceptos & Prototipos
        </button>
        <button data-filter="current" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all">
          Gama Actual
        </button>
      </div>
    </div>

    <!-- Grid de Modelos -->
    <div id="modelsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Se inyecta dinámicamente -->
    </div>

    <!-- Paginación / Contador -->
    <div class="mt-8 text-center text-xs font-mono text-slate-500" id="resultsCount">
      Mostrando modelos...
    </div>
  </section>

  <!-- Modal / Visor de Frontal y Detalle de Variantes -->
  <div id="viewModal" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-3xl w-full overflow-hidden shadow-2xl flex flex-col max-h-[90vh]">
      <!-- Header del modal -->
      <div class="p-6 border-b border-slate-800 flex items-center justify-between bg-slate-950/50">
        <div>
          <div class="flex items-center gap-2">
            <span id="modalCategory" class="text-xs font-mono px-2 py-0.5 rounded bg-slate-800 text-cyan-400 uppercase tracking-wider"></span>
            <span id="modalBadgeM" class="hidden text-xs font-mono px-2 py-0.5 rounded bg-red-500/20 text-red-300 border border-red-500/30">BMW M High Performance</span>
          </div>
          <h3 id="modalTitle" class="text-2xl font-bold text-white mt-1"></h3>
          <p id="modalSubtitle" class="text-xs text-slate-400 mt-1"></p>
        </div>
        <button id="closeModal" class="p-2 rounded-lg bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Contenedor del Visor -->
      <div class="p-6 flex-1 overflow-y-auto space-y-6">
        <!-- Indicador de vista frontal exterior -->
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider">Vista Frontal Exterior Limpia</span>
          <span id="modalChassisCode" class="text-xs font-mono text-slate-400"></span>
        </div>

        <!-- Imagen Frontal -->
        <div class="relative aspect-video rounded-xl overflow-hidden bg-slate-950 border border-slate-800/80 flex items-center justify-center group">
          <img id="modalImage" src="" alt="Vista frontal del coche" class="w-full h-full object-contain transition-all duration-300" />
          <div id="noImageView" class="hidden flex-col items-center justify-center text-slate-500 p-8 text-center">
            <svg class="w-12 h-12 mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <p class="text-sm font-medium">Fotografía en proceso de curación libre</p>
            <p class="text-xs text-slate-600 mt-1">Disponible próximamente desde archivo fotográfico abierto</p>
          </div>
        </div>

        <!-- Atribución Legal de la Imagen -->
        <div id="attributionBox" class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/60 flex items-center justify-between text-xs text-slate-400">
          <div>
            <span class="text-slate-500">Fotógrafo:</span> <span id="attrAuthor" class="text-slate-300 font-medium"></span> • 
            <span class="text-slate-500">Licencia:</span> <span id="attrLicense" class="text-slate-300 font-mono"></span>
          </div>
          <a id="attrLink" href="" target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:underline flex items-center gap-1">
            Ficha original en Commons ↗
          </a>
        </div>

        <!-- Sección de Comparación de Acabados / Variantes registradas -->
        <div class="border-t border-slate-800/80 pt-4">
          <h4 class="text-xs font-mono text-slate-400 uppercase tracking-wider mb-2">Acabados & Paquetes Visuales en este Modelo</h4>
          <div id="packagesContainer" class="flex flex-wrap gap-2 mb-4">
            <!-- Badges -->
          </div>

          <h4 class="text-xs font-mono text-slate-400 uppercase tracking-wider mb-2">Variantes de Modelo & Motorización en este Chasis</h4>
          <div id="variantsContainer" class="flex flex-wrap gap-1.5">
            <!-- Variantes -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sección API Pública -->
  <section id="api" class="border-t border-slate-900 bg-slate-950 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">API Pública & Gratuita Carvault</h2>
        <p class="mt-2 text-sm text-slate-400">
          Todos los modelos, chasis individuales, variantes y gamas M con enlaces directos a sus fotografías frontales limpias.
        </p>
      </div>

      <div class="mt-8 max-w-3xl mx-auto bg-slate-900 border border-slate-800 rounded-2xl p-6 font-mono text-xs">
        <div class="flex items-center justify-between text-slate-400 pb-3 border-b border-slate-800">
          <span>GET Endpoint BMW Completo (Incluye Gama M)</span>
          <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[10px]">CORS Habilitado • $0 Coste</span>
        </div>
        <div class="mt-4 text-cyan-300 flex items-center justify-between bg-slate-950 p-3 rounded-lg border border-slate-800">
          <code>GET /api/v1/bmw.json</code>
          <a href="/api/v1/bmw.json" target="_blank" class="text-xs text-slate-400 hover:text-white px-2 py-1 rounded bg-slate-800 transition-colors">
            Probar JSON en vivo ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Script Cliente Interactivo -->
  <script is:inline define:vars={{ modelsJson }}>
    const models = JSON.parse(modelsJson);
    let activeFilter = 'all';
    let searchQuery = '';
    let currentModel = null;

    const grid = document.getElementById('modelsGrid');
    const searchInput = document.getElementById('searchInput');
    const filterButtons = document.querySelectorAll('.filter-btn');
    const resultsCount = document.getElementById('resultsCount');

    // Elementos del Modal
    const modal = document.getElementById('viewModal');
    const closeModal = document.getElementById('closeModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalSubtitle = document.getElementById('modalSubtitle');
    const modalCategory = document.getElementById('modalCategory');
    const modalBadgeM = document.getElementById('modalBadgeM');
    const modalChassisCode = document.getElementById('modalChassisCode');
    const modalImage = document.getElementById('modalImage');
    const noImageView = document.getElementById('noImageView');
    const attrAuthor = document.getElementById('attrAuthor');
    const attrLicense = document.getElementById('attrLicense');
    const attrLink = document.getElementById('attrLink');
    const attributionBox = document.getElementById('attributionBox');
    const packagesContainer = document.getElementById('packagesContainer');
    const variantsContainer = document.getElementById('variantsContainer');

    function renderModels() {
      const filtered = models.filter(m => {
        // Filtros por pestaña
        if (activeFilter === 'm-performance' && m.section !== 'm-performance') return false;
        if (activeFilter === 'production' && m.section !== 'production') return false;
        if (activeFilter === 'prototypes' && m.section !== 'prototypes') return false;
        if (activeFilter === 'current' && m.status !== 'current') return false;

        // Búsqueda inteligente: modelo (M2), motorización (320i), chasis (G87, E46), paquete (M Sport)
        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const matchLabel = m.label.toLowerCase().includes(q);
          const matchSeries = m.series.toLowerCase().includes(q);
          const matchClass = (m.class || '').toLowerCase().includes(q);
          const matchChassis = m.chassis.some(c => (c.code || '').toLowerCase().includes(q));
          const matchVariant = m.chassis.some(c => (c.variants || []).some(v => v.toLowerCase().includes(q)));
          const matchPackage = m.chassis.some(c => (c.packages || []).some(p => p.toLowerCase().includes(q)));
          
          if (!matchLabel && !matchSeries && !matchChassis && !matchVariant && !matchClass && !matchPackage) return false;
        }
        return true;
      });

      resultsCount.textContent = `Mostrando ${filtered.length} de ${models.length} modelos de BMW`;

      grid.innerHTML = filtered.map(m => {
        const firstChassis = m.chassis[0] || {};
        const front = m.frontImage || firstChassis.frontImage;
        const chassisCodes = m.chassis.map(c => c.code).filter(Boolean).join(', ') || 'N/A';
        const isCurrent = m.status === 'current';
        const isM = m.section === 'm-performance';

        return `
          <div class="bg-slate-900/60 border ${isM ? 'border-indigo-500/40 hover:border-indigo-400' : 'border-slate-800 hover:border-cyan-500/50'} rounded-2xl overflow-hidden transition-all duration-300 flex flex-col group hover:-translate-y-1">
            <div class="aspect-[16/10] bg-slate-950 relative overflow-hidden flex items-center justify-center">
              ${front?.url 
                ? `<img src="${front.url}" alt="${m.label}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />`
                : `<div class="text-slate-600 text-xs font-mono flex flex-col items-center gap-1">
                    <svg class="w-8 h-8 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    <span>Sin foto frontal</span>
                   </div>`
              }
              <div class="absolute top-3 left-3 flex items-center gap-1">
                ${isM ? `
                  <span class="px-2 py-0.5 rounded bg-red-500/20 border border-red-500/40 text-[10px] font-bold text-red-300 tracking-wider">
                    BMW M
                  </span>
                ` : ''}
                ${isCurrent ? `
                  <span class="px-2 py-0.5 rounded bg-emerald-500/20 border border-emerald-500/30 text-[10px] font-semibold text-emerald-300">
                    Actual
                  </span>
                ` : ''}
              </div>
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs text-slate-500 font-mono mb-1">
                  <span>${m.years.display}</span>
                  <span class="text-cyan-400 font-semibold">${chassisCodes}</span>
                </div>
                <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors">
                  ${m.label}
                </h3>
                <p class="text-xs text-slate-400 mt-1 line-clamp-1">
                  ${m.class || 'Modelo BMW'}
                </p>
              </div>

              <div class="mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <span class="text-[11px] text-slate-500 font-mono">
                  ${m.chassis.reduce((acc, c) => acc + (c.variants?.length || 0), 0)} variantes
                </span>
                <button 
                  onclick="openModelModal('${m.id}')"
                  class="px-3.5 py-1.5 rounded-lg text-xs font-semibold ${isM ? 'bg-indigo-500/20 text-indigo-300 border-indigo-500/40 hover:bg-indigo-500 hover:text-white' : 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30 hover:bg-cyan-500 hover:text-slate-950'} border transition-all cursor-pointer"
                >
                  Ver frontal & variantes →
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Modal controls
    window.openModelModal = function(modelId) {
      currentModel = models.find(m => m.id === modelId);
      if (!currentModel) return;

      const isM = currentModel.section === 'm-performance';
      modalCategory.textContent = isM ? 'BMW M Motorsport' : currentModel.section === 'prototypes' ? 'Prototipo / Concepto' : 'Modelo de Producción';
      if (isM) modalBadgeM.classList.remove('hidden');
      else modalBadgeM.classList.add('hidden');

      modalTitle.textContent = currentModel.label;
      modalSubtitle.textContent = `${currentModel.years.display} • ${currentModel.class || ''}`;
      
      const firstChassis = currentModel.chassis[0] || {};
      modalChassisCode.textContent = firstChassis.code ? `Chasis: ${firstChassis.code}` : '';

      const imgData = currentModel.frontImage || firstChassis.frontImage;
      if (imgData && imgData.url) {
        modalImage.src = imgData.url;
        modalImage.classList.remove('hidden');
        noImageView.classList.add('hidden');
        attributionBox.classList.remove('hidden');

        attrAuthor.textContent = imgData.author || 'Wikimedia Commons';
        attrLicense.textContent = imgData.license || 'CC';
        attrLink.href = imgData.sourceUrl || '#';
      } else {
        modalImage.classList.add('hidden');
        noImageView.classList.remove('hidden');
        attributionBox.classList.add('hidden');
      }

      // Paquetes
      const packages = firstChassis.packages || ['Base', 'M Sport'];
      packagesContainer.innerHTML = packages.map(p => `
        <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-slate-800/80 border border-slate-700 text-slate-300">
          ${p}
        </span>
      `).join('');

      // Variantes
      const variants = firstChassis.variants || [];
      if (variants.length) {
        variantsContainer.innerHTML = variants.map(v => `
          <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-cyan-950/60 border border-cyan-800/50 text-cyan-300">
            ${v}
          </span>
        `).join('');
      } else {
        variantsContainer.innerHTML = `<span class="text-xs text-slate-500 font-mono">Sin variantes secundarias registradas</span>`;
      }

      modal.classList.remove('hidden');
    };

    closeModal.addEventListener('click', () => {
      modal.classList.add('hidden');
      currentModel = null;
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        currentModel = null;
      }
    });

    // Filtros
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.className = "filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all";
        });
        btn.className = "filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-cyan-500 text-slate-950 transition-all";
        activeFilter = btn.dataset.filter;
        renderModels();
      });
    });

    // Búsqueda
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim();
      renderModels();
    });

    // Render inicial
    renderModels();
  </script>
</Layout>
