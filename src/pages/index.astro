  <!-- Script Cliente del Buscador Global -->
  <script is:inline define:vars={{ globalCarsJson, brandsJson, registryJson }}>
    const allCars = JSON.parse(globalCarsJson);
    const brands = JSON.parse(brandsJson);
    const registry = JSON.parse(registryJson);

    let globalSearchQuery = '';
    let globalBrand = 'all';
    let globalEra = 'all';
    let globalConcept = 'all';
    let globalSort = 'year-desc';
    let globalCustomYearFrom = null;
    let globalCustomYearTo = null;

    // DOM
    const grid = document.getElementById('globalModelsGrid');
    const searchInput = document.getElementById('globalSearchInput');
    const clearSearchBtn = document.getElementById('globalClearSearchBtn');
    const brandSelect = document.getElementById('globalBrandSelect');
    const eraSelect = document.getElementById('globalEraSelect');
    const conceptSelect = document.getElementById('globalConceptSelect');
    const sortSelect = document.getElementById('globalSortSelect');
    const customYearsContainer = document.getElementById('globalCustomYearsContainer');
    const yearFromInput = document.getElementById('globalYearFromInput');
    const yearToInput = document.getElementById('globalYearToInput');
    const applyYearsBtn = document.getElementById('globalApplyYearsBtn');
    const resultsCount = document.getElementById('globalResultsCount');
    const resetFiltersBtn = document.getElementById('globalResetFiltersBtn');
    const initialState = document.getElementById('globalInitialState');
    const emptyState = document.getElementById('globalEmptyState');
    const emptyResetBtn = document.getElementById('globalEmptyResetBtn');

    // Lightbox
    const lightbox = document.getElementById('homeLightbox');
    const lightboxImg = document.getElementById('homeLightboxImg');
    const lightboxTitle = document.getElementById('homeLightboxTitle');
    const lightboxSubtitle = document.getElementById('homeLightboxSubtitle');
    const closeLightbox = document.getElementById('closeHomeLightbox');

    window.openHomeLightbox = function(url, title, subtitle) {
      if (!url) return;
      lightboxImg.src = url;
      lightboxTitle.textContent = title || '';
      lightboxSubtitle.textContent = subtitle || '';
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };

    function closeHomeLightboxModal() {
      lightbox.classList.add('hidden');
      lightboxImg.src = '';
      document.body.style.overflow = '';
    }

    closeLightbox.addEventListener('click', closeHomeLightboxModal);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === lightboxImg.parentElement) {
        closeHomeLightboxModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
        closeHomeLightboxModal();
      }
    });

    // Atajo "/"
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'SELECT') {
        e.preventDefault();
        searchInput.focus();
      }
    });

    function matchesEra(c, eraVal) {
      if (eraVal === 'all') return true;
      const start = c.years?.start || 0;
      const end = c.years?.end || start;

      if (eraVal === '2020-present') return end >= 2020;
      if (eraVal === '2010-2019') return start <= 2019 && end >= 2010;
      if (eraVal === '2000-2009') return start <= 2009 && end >= 2000;
      if (eraVal === '1990-1999') return start <= 1999 && end >= 1990;
      if (eraVal === '1980-1989') return start <= 1989 && end >= 1980;
      if (eraVal === '1960-1979') return start <= 1979 && end >= 1960;
      if (eraVal === 'pre-1960') return start < 1960;
      if (eraVal === 'custom') {
        const from = globalCustomYearFrom || 1927;
        const to = globalCustomYearTo || 2026;
        return start <= to && end >= from;
      }
      return true;
    }

    function renderGlobalCars() {
      // Indicador de filtros activos
      let activeCount = 0;
      if (globalSearchQuery) activeCount++;
      if (globalBrand !== 'all') activeCount++;
      if (globalEra !== 'all') activeCount++;
      if (globalConcept !== 'all') activeCount++;
      if (globalSort !== 'year-desc') activeCount++;

      if (activeCount > 0) {
        resetFiltersBtn.classList.remove('hidden');
        resetFiltersBtn.classList.add('inline-flex');
      } else {
        resetFiltersBtn.classList.add('hidden');
        resetFiltersBtn.classList.remove('inline-flex');
      }

      // Requerimiento: No cargar todos los coches a no ser que el usuario busque algo o filtre
      const isSearchActive = !!globalSearchQuery || globalBrand !== 'all' || globalEra !== 'all' || globalConcept !== 'all';

      if (!isSearchActive) {
        grid.innerHTML = '';
        if (initialState) initialState.classList.remove('hidden');
        if (emptyState) emptyState.classList.add('hidden');
        resultsCount.textContent = `Buscador listo • Selecciona una marca abajo o escribe un modelo para ver sus fotos frontales`;
        return;
      }

      if (initialState) initialState.classList.add('hidden');

      const filtered = allCars.filter(c => {
        // Filtro Marca / Fabricante
        if (globalBrand !== 'all') {
          const bMatch = c.brandId === globalBrand || (c.brandName || '').toLowerCase() === globalBrand.toLowerCase();
          if (!bMatch) return false;
        }

        // Filtro Conceptos
        if (globalConcept === 'production' && c.section === 'prototypes') return false;
        if (globalConcept === 'prototypes' && c.section !== 'prototypes') return false;

        // Filtro Época
        if (!matchesEra(c, globalEra)) return false;

        // Búsqueda por Texto
        if (globalSearchQuery) {
          const tokens = globalSearchQuery.toLowerCase().split(/\s+/).filter(Boolean);
          const fullText = `${c.label || ''} ${c.brandName || ''} ${c.series || ''} ${c.class || ''} ${c.chassisCodes || ''} ${c.years?.display || ''}`.toLowerCase();
          const matchAll = tokens.every(tok => fullText.includes(tok));
          if (!matchAll) return false;
        }

        return true;
      });

      // Ordenación
      filtered.sort((a, b) => {
        if (globalSort === 'year-desc') return (b.years?.start || 0) - (a.years?.start || 0);
        if (globalSort === 'year-asc') return (a.years?.start || 0) - (b.years?.start || 0);
        if (globalSort === 'name-asc') return a.label.localeCompare(b.label);
        return 0;
      });

      resultsCount.textContent = `Mostrando ${filtered.length} vehículo${filtered.length === 1 ? '' : 's'} coincidentes`;

      if (filtered.length === 0) {
        grid.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      } else {
        emptyState.classList.add('hidden');
      }

      grid.innerHTML = filtered.map(c => {
        const isM = c.isM;
        const isCurrent = c.status === 'current';
        const isProto = c.section === 'prototypes';

        return `
          <div class="bg-slate-900/60 border ${isM ? 'border-indigo-500/40 hover:border-indigo-400' : 'border-slate-800 hover:border-cyan-500/50'} rounded-2xl overflow-hidden transition-all duration-300 flex flex-col group hover:-translate-y-1 shadow-lg">
            <div class="aspect-[16/10] bg-slate-950 relative overflow-hidden flex items-center justify-center group/img">
              ${c.frontImage?.url 
                ? `<img src="${c.frontImage.url}" alt="${c.label}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                   <button 
                     onclick="event.stopPropagation(); openHomeLightbox('${c.frontImage.url}', '${c.label.replace(/'/g, "\\'")}', '${c.brandName} • ${(c.years?.display || '').replace(/'/g, "\\'")}')" 
                     class="absolute bottom-2.5 right-2.5 p-2 rounded-xl bg-slate-950/80 hover:bg-cyan-500 text-slate-300 hover:text-slate-950 backdrop-blur-md border border-slate-700/80 hover:border-cyan-400 transition-all opacity-0 group-hover:opacity-100 flex items-center gap-1.5 text-xs font-mono shadow-lg cursor-pointer"
                     title="Ver imagen completa sin recortes"
                   >
                     <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
                     <span class="text-[11px] font-semibold">Ampliar</span>
                   </button>`
                : `<div class="text-slate-600 text-xs font-mono">Sin foto frontal</div>`
              }
              <div class="absolute top-3 left-3 flex items-center gap-1.5 flex-wrap">
                <span class="px-2 py-0.5 rounded-md bg-slate-950 text-slate-200 border border-slate-800 text-[10px] font-bold font-mono flex items-center gap-1">
                  <img src="${c.brandLogo}" class="w-3.5 h-3.5" alt="${c.brandName}" />
                  ${c.brandName}
                </span>
                ${isM ? `
                  <span class="px-2 py-0.5 rounded-md bg-red-600 text-white text-[10px] font-black uppercase tracking-wider shadow-sm">
                    M
                  </span>
                ` : ''}
                ${c.isVZ ? `
                  <span class="px-2 py-0.5 rounded-md bg-amber-600 text-white text-[10px] font-black uppercase tracking-wider shadow-sm">
                    VZ
                  </span>
                ` : ''}
                ${c.isSVO ? `
                  <span class="px-2 py-0.5 rounded-md bg-emerald-600 text-white text-[10px] font-black uppercase tracking-wider shadow-sm">
                    SVO
                  </span>
                ` : ''}
                ${isCurrent ? `
                  <span class="px-2 py-0.5 rounded-md bg-emerald-600 text-white text-[10px] font-bold shadow-sm">
                    Actual
                  </span>
                ` : ''}
                ${isProto ? `
                  <span class="px-2 py-0.5 rounded-md bg-amber-600 text-white text-[10px] font-bold shadow-sm">
                    Concepto
                  </span>
                ` : ''}
              </div>
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs text-slate-500 font-mono mb-1.5">
                  <span class="bg-slate-800/80 px-2 py-0.5 rounded border border-slate-700/60 text-slate-300">${c.years?.display || ''}</span>
                  <span class="text-cyan-400 font-bold font-mono">${c.chassisCodes ? 'Chasis: ' + c.chassisCodes : ''}</span>
                </div>
                <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors">
                  ${c.label}
                </h3>
                <p class="text-xs text-slate-400 mt-1 line-clamp-1">
                  ${c.class || 'Modelo ' + c.brandName}
                </p>
              </div>

              <div class="mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <a 
                  href="${c.brandCatalogUrl}" 
                  class="text-xs font-mono text-cyan-400 hover:text-cyan-300 flex items-center gap-1"
                >
                  <span>Ver en catálogo ${c.brandName}</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Listeners
    searchInput.addEventListener('input', (e) => {
      globalSearchQuery = e.target.value.trim();
      if (globalSearchQuery) {
        clearSearchBtn.classList.remove('hidden');
      } else {
        clearSearchBtn.classList.add('hidden');
      }
      renderGlobalCars();
    });

    clearSearchBtn.addEventListener('click', () => {
      searchInput.value = '';
      globalSearchQuery = '';
      clearSearchBtn.classList.add('hidden');
      renderGlobalCars();
      searchInput.focus();
    });

    if (brandSelect) {
      brandSelect.addEventListener('change', (e) => {
        globalBrand = e.target.value;
        renderGlobalCars();
      });
    }

    eraSelect.addEventListener('change', (e) => {
      globalEra = e.target.value;
      if (globalEra === 'custom') {
        customYearsContainer.classList.remove('hidden');
      } else {
        customYearsContainer.classList.add('hidden');
      }
      renderGlobalCars();
    });

    applyYearsBtn.addEventListener('click', () => {
      globalCustomYearFrom = parseInt(yearFromInput.value, 10) || null;
      globalCustomYearTo = parseInt(yearToInput.value, 10) || null;
      renderGlobalCars();
    });

    conceptSelect.addEventListener('change', (e) => {
      globalConcept = e.target.value;
      renderGlobalCars();
    });

    sortSelect.addEventListener('change', (e) => {
      globalSort = e.target.value;
      renderGlobalCars();
    });

    function resetAllGlobal() {
      searchInput.value = '';
      globalSearchQuery = '';
      clearSearchBtn.classList.add('hidden');
      if (brandSelect) brandSelect.value = 'all';
      globalBrand = 'all';
      eraSelect.value = 'all';
      globalEra = 'all';
      conceptSelect.value = 'all';
      globalConcept = 'all';
      sortSelect.value = 'year-desc';
      globalSort = 'year-desc';
      customYearsContainer.classList.add('hidden');
      yearFromInput.value = '';
      yearToInput.value = '';
      globalCustomYearFrom = null;
      globalCustomYearTo = null;
      renderGlobalCars();
    }

    resetFiltersBtn.addEventListener('click', resetAllGlobal);
    emptyResetBtn.addEventListener('click', resetAllGlobal);

    // Soporte para URL params si viene enlazado con marca o búsqueda: /carvault/?brand=bmw&q=m3
    const homeUrlParams = new URLSearchParams(window.location.search);
    const homeBrandParam = homeUrlParams.get('brand') || homeUrlParams.get('marca');
    if (homeBrandParam && brandSelect) {
      brandSelect.value = homeBrandParam.toLowerCase();
      globalBrand = homeBrandParam.toLowerCase();
    }
    const homeQParam = homeUrlParams.get('q') || homeUrlParams.get('car') || homeUrlParams.get('model');
    if (homeQParam && searchInput) {
      searchInput.value = homeQParam;
      globalSearchQuery = homeQParam;
      clearSearchBtn.classList.remove('hidden');
    }
    if (homeBrandParam || homeQParam) {
      renderGlobalCars();
    }

    // ==========================================
    // Lógica del Pop-up y API de Solicitud de Modelos
    // ==========================================
    const requestModal = document.getElementById('requestModelModal');
    const openRequestModalBtn = document.getElementById('openRequestModalBtn');
    const closeRequestModalBtn = document.getElementById('closeRequestModalBtn');
    const cancelRequestBtn = document.getElementById('cancelRequestBtn');
    const requestForm = document.getElementById('requestModelForm');
    const requestInput = document.getElementById('requestModelInput');
    const charCountLabel = document.getElementById('charCountLabel');
    const feedbackMsg = document.getElementById('requestFeedbackMessage');
    const submitBtn = document.getElementById('submitRequestBtn');
    const submitBtnText = document.getElementById('submitRequestBtnText');
    const submitSpinner = document.getElementById('submitRequestSpinner');

    let liveOpenIssues = null;
    let liveIssuesFetched = false;
    let cachedGwUrl = null;

    async function getActiveGatewayUrl() {
      if (cachedGwUrl) return cachedGwUrl;
      try {
        const res = await fetch('https://api.github.com/repos/amglogicalis/carvault/contents/gateway-url.json?ref=gw-url');
        if (res.ok) {
          const d = await res.json();
          if (d && d.content) {
            const parsed = JSON.parse(atob(d.content.replace(/\s+/g, '')));
            if (parsed && parsed.url) {
              cachedGwUrl = parsed.url;
              return parsed.url;
            }
          }
        }
      } catch (e) {}
      try {
        const res = await fetch('https://raw.githubusercontent.com/amglogicalis/carvault/gw-url/gateway-url.json?t=' + Date.now());
        if (res.ok) {
          const d = await res.json();
          if (d && d.url) {
            cachedGwUrl = d.url;
            return d.url;
          }
        }
      } catch (e) {}
      return null;
    }

    async function syncLiveIssues() {
      try {
        const gwUrl = await getActiveGatewayUrl();
        if (gwUrl) {
          const res = await fetch(`${gwUrl}/open-issues`);
          if (res.ok) {
            const list = await res.json();
            if (Array.isArray(list)) {
              liveOpenIssues = list;
              liveIssuesFetched = true;
              return;
            }
          }
        }
      } catch (e) {}

      try {
        const res = await fetch('https://api.github.com/repos/amglogicalis/carvault/issues?state=open&per_page=100');
        if (res.ok) {
          const issues = await res.json();
          if (Array.isArray(issues)) {
            liveOpenIssues = issues;
            liveIssuesFetched = true;
          }
        }
      } catch (e) {
        // En caso de modo offline o error de red, se mantiene el registry estático
      }
    }

    function openRequestModal() {
      if (!requestModal) return;
      requestModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      if (feedbackMsg) {
        feedbackMsg.classList.add('hidden');
        feedbackMsg.textContent = '';
      }
      syncLiveIssues();
      setTimeout(() => {
        if (requestInput) requestInput.focus();
      }, 100);
    }

    function closeRequestModal() {
      if (!requestModal) return;
      requestModal.classList.add('hidden');
      document.body.style.overflow = '';
      if (requestInput) requestInput.value = '';
      if (charCountLabel) charCountLabel.textContent = '0 / 250';
    }

    if (openRequestModalBtn) openRequestModalBtn.addEventListener('click', openRequestModal);
    if (closeRequestModalBtn) closeRequestModalBtn.addEventListener('click', closeRequestModal);
    if (cancelRequestBtn) cancelRequestBtn.addEventListener('click', closeRequestModal);

    if (requestModal) {
      requestModal.addEventListener('click', (e) => {
        if (e.target === requestModal) closeRequestModal();
      });
    }

    // Contador de caracteres
    if (requestInput && charCountLabel) {
      requestInput.addEventListener('input', (e) => {
        const len = e.target.value.length;
        charCountLabel.textContent = `${len} / 250`;
        if (len >= 240) {
          charCountLabel.classList.add('text-amber-400');
        } else {
          charCountLabel.classList.remove('text-amber-400');
        }
      });
    }

    // Normalización y tokenizer en cliente para filtrado middleware
    function clientNormalize(str) {
      return (str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9\s]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    function clientTokenize(str) {
      const stopWords = new Set([
        'el', 'la', 'los', 'las', 'un', 'una', 'de', 'del', 'con', 'por', 'para',
        'en', 'ano', 'anos', 'model', 'modelo', 'coche', 'car', 'falta', 'queria', 'pedir'
      ]);
      return clientNormalize(str)
        .split(' ')
        .filter(t => t.length >= 2 && !stopWords.has(t));
    }

    const SPEC_OR_BODY = /^(19\d\d|20\d\d|v[68]|v10|v12|manual|auto|coupe|cabrio|sedan|berlina|avant|touring|suv|roadster|spider|sportback|gt|edition)$/;

    function isClientDuplicate(candidate, rawTitle) {
      const cleanTitle = (rawTitle || '').replace(/^\[.*?\]:?\s*/i, '').replace(/^solicitud.*?:?\s*/i, '').trim();
      const normCand = clientNormalize(candidate);
      const normExist = clientNormalize(cleanTitle);
      if (normCand === normExist) return true;

      const tokensCand = clientTokenize(candidate);
      const tokensExist = clientTokenize(cleanTitle);
      if (tokensCand.length === 0 || tokensExist.length === 0) return false;

      const joinedCand = tokensCand.join(' ');
      const joinedExist = tokensExist.join(' ');
      if (joinedCand === joinedExist) return true;

      if (tokensCand.length <= 2 && tokensExist.length <= 2 && joinedCand === joinedExist) return true;

      const coreCand = tokensCand.filter(t => !SPEC_OR_BODY.test(t));
      const coreExist = tokensExist.filter(t => !SPEC_OR_BODY.test(t));

      const coreJoinedCand = coreCand.join(' ');
      const coreJoinedExist = coreExist.join(' ');
      if (coreJoinedCand && coreJoinedExist && coreJoinedCand === coreJoinedExist) return true;

      const setExist = new Set(tokensExist);
      const setCand = new Set(tokensCand);
      const common = tokensCand.filter(t => setExist.has(t));

      const diffCand = tokensCand.filter(t => !setExist.has(t) && !SPEC_OR_BODY.test(t));
      const diffExist = tokensExist.filter(t => !setCand.has(t) && !SPEC_OR_BODY.test(t));

      if (common.length >= 2 && diffCand.length === 0 && diffExist.length === 0) {
        return true;
      }

      return false;
    }

    function evaluateClientMiddleware(inputText) {
      const normInput = clientNormalize(inputText);
      const inputTokens = clientTokenize(inputText);

      // 1. Longitud básica
      if (!inputText || inputText.trim().length < 3) {
        return {
          allowed: false,
          reason: 'El texto es demasiado corto. Especifica al menos el nombre de la marca o modelo (mínimo 3 caracteres).'
        };
      }

      if (inputText.length > 250) {
        return {
          allowed: false,
          reason: 'El texto excede el límite permitido de 250 caracteres. Por favor, sé sintético (ej. "Audi RS6 C7 Avant 2013").'
        };
      }

      // 2. Basura evidente
      const isGibberish = /^(.)\1{4,}$/.test(normInput) || inputTokens.length === 0;
      if (isGibberish) {
        return {
          allowed: false,
          reason: 'Por favor, introduce un nombre de modelo o fabricante automotriz válido.'
        };
      }

      // 3. Comprobar si ya existe en catálogo
      if (normInput === 'bmw' || normInput === 'bayerische motoren werke') {
        return {
          allowed: false,
          reason: 'BMW ya cuenta con un catálogo completo de 200 modelos y 279 chasis activo en Carvault.'
        };
      }

      if (registry && registry.existingCatalogCache && registry.existingCatalogCache.models) {
        for (const m of registry.existingCatalogCache.models) {
          const normLabel = clientNormalize(m.label);
          if (normInput === normLabel) {
            return {
              allowed: false,
              reason: `El modelo "${m.label}" ya está disponible en nuestro catálogo.`
            };
          }

          if (m.codes && Array.isArray(m.codes)) {
            for (const code of m.codes) {
              if (code && code.length >= 3) {
                const regex = new RegExp(`\\b${code}\\b`, 'i');
                if (regex.test(normInput)) {
                  const labelTokens = clientTokenize(m.label);
                  const commonTokens = inputTokens.filter(t => labelTokens.includes(t) || t === code);
                  if (commonTokens.length >= 2 || inputTokens.includes(code.toLowerCase())) {
                    return {
                      allowed: false,
                      reason: `El modelo con chasis ${code.toUpperCase()} ("${m.label}") ya está registrado en el catálogo de Carvault.`
                    };
                  }
                }
              }
            }
          }
        }
      }

      // 4. Comprobar en historial de solicitudes activas (tiempo real si hay conexión)
      // Las issues cerradas NO están en liveOpenIssues, por lo que NO bloquean
      if (liveIssuesFetched && Array.isArray(liveOpenIssues)) {
        for (const issue of liveOpenIssues) {
          if (isClientDuplicate(inputText, issue.title)) {
            return {
              allowed: false,
              reason: `Ya existe una solicitud abierta para este modelo (Issue #${issue.number}). Nuestro equipo ya está trabajando en ella.`
            };
          }
        }
      }

      return { allowed: true };
    }

    // Envío del formulario y filtro Middleware
    if (requestForm) {
      requestForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const textVal = (requestInput?.value || '').trim();
        if (!textVal) return;

        // Estado de carga
        submitBtn.disabled = true;
        submitBtnText.textContent = 'Verificando con filtro...';
        submitSpinner.classList.remove('hidden');
        feedbackMsg.classList.add('hidden');

        // 1. Evaluación directa por Middleware en el cliente
        const evalResult = evaluateClientMiddleware(textVal);
        if (!evalResult.allowed) {
          submitBtn.disabled = false;
          submitBtnText.textContent = 'Enviar solicitud';
          submitSpinner.classList.add('hidden');

          feedbackMsg.className = 'p-3 rounded-xl text-xs font-mono border bg-amber-500/10 border-amber-500/30 text-amber-300';
          feedbackMsg.innerHTML = `
            <div class="flex items-start gap-2">
              <span>⚠️</span>
              <div>
                <p class="font-bold">Solicitud no enviada:</p>
                <p class="mt-0.5 text-slate-300">${evalResult.reason}</p>
              </div>
            </div>
          `;
          feedbackMsg.classList.remove('hidden');
          return;
        }

        // 2. Procesamiento de la solicitud verificada
        submitBtnText.textContent = 'Enviando al gateway seguro...';

        let createdIssueNumber = null;

        // Si estamos en entorno local con API Node activa (/carvault/api/request-model)
        if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
          try {
            const localRes = await fetch('/carvault/api/request-model', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ text: textVal })
            });
            if (localRes.ok) {
              const data = await localRes.json();
              if (data.success) createdIssueNumber = data.issue || 'confirmada';
            }
          } catch (ignored) {}
        }

        // Si no se creó en servidor local, usamos el Gateway Privado (Terra/Phryx tunnel)
        if (!createdIssueNumber) {
          try {
            // Obtenemos dinámicamente la URL activa del Gateway desde el registro publicado
            const gwInfoRes = await fetch('https://raw.githubusercontent.com/amglogicalis/carvault/gw-url/gateway-url.json?t=' + Date.now());
            if (gwInfoRes.ok) {
              const gwInfo = await gwInfoRes.json();
              if (gwInfo && gwInfo.url) {
                // 1. Obtener Bearer Token de sesión temporal firmado
                submitBtnText.textContent = 'Generando token de sesión...';
                const sessionRes = await fetch(`${gwInfo.url}/session`, { method: 'POST' });
                if (sessionRes.ok) {
                  const sessionData = await sessionRes.json();
                  if (sessionData && sessionData.token) {
                    // 2. Enviar la petición al Gateway Privado con el Bearer Token
                    submitBtnText.textContent = 'Registrando en repositorio...';
                    const postRes = await fetch(`${gwInfo.url}/request`, {
                      method: 'POST',
                      headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${sessionData.token}`
                      },
                      body: JSON.stringify({ text: textVal })
                    });
                    const postData = await postRes.json().catch(() => ({}));

                    if (postRes.status === 409 || postData.error === 'duplicate') {
                      submitBtn.disabled = false;
                      submitBtnText.textContent = 'Enviar solicitud';
                      submitSpinner.classList.add('hidden');

                      feedbackMsg.className = 'p-3 rounded-xl text-xs font-mono border bg-amber-500/10 border-amber-500/30 text-amber-300 shadow-md animate-fade-in';
                      feedbackMsg.innerHTML = `
                        <div class="flex items-start gap-2">
                          <span class="text-base">⚠️</span>
                          <div>
                            <p class="font-bold">Solicitud no enviada:</p>
                            <p class="mt-0.5 text-slate-300 leading-relaxed">${postData.reason || 'Ya existe una solicitud abierta para este modelo.'}</p>
                          </div>
                        </div>
                      `;
                      feedbackMsg.classList.remove('hidden');
                      return;
                    }

                    if (postRes.status === 400 || postData.error === 'validation') {
                      submitBtn.disabled = false;
                      submitBtnText.textContent = 'Enviar solicitud';
                      submitSpinner.classList.add('hidden');

                      feedbackMsg.className = 'p-3 rounded-xl text-xs font-mono border bg-amber-500/10 border-amber-500/30 text-amber-300 shadow-md animate-fade-in';
                      feedbackMsg.innerHTML = `
                        <div class="flex items-start gap-2">
                          <span class="text-base">⚠️</span>
                          <div>
                            <p class="font-bold">Solicitud no enviada:</p>
                            <p class="mt-0.5 text-slate-300 leading-relaxed">${postData.reason || 'Por favor, introduce un nombre de modelo válido.'}</p>
                          </div>
                        </div>
                      `;
                      feedbackMsg.classList.remove('hidden');
                      return;
                    }

                    if (postRes.ok && postData.success) {
                      createdIssueNumber = postData.issue || 'creada';
                    }
                  }
                }
              }
            }
          } catch (e) {
            console.warn('Gateway dispatch attempt completed with note:', e);
          }
        }

        // Registrar localmente en la sesión activa para evitar duplicados inmediatos en la misma navegación
        if (liveOpenIssues) {
          liveOpenIssues.push({
            number: createdIssueNumber || 'activa',
            title: `[Propuesta de Vehículo]: ${textVal}`
          });
        }

        // 3. Feedback visual elegante 100% integrado en la interfaz de Carvault (sin redirigir ni abrir pestañas)
        if (createdIssueNumber) {
          feedbackMsg.className = 'p-4 rounded-2xl text-xs font-mono border bg-emerald-500/10 border-emerald-500/30 text-emerald-300 shadow-lg animate-fade-in';
          feedbackMsg.innerHTML = `
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-300 flex items-center justify-center font-bold text-sm shrink-0">✓</div>
              <div>
                <p class="font-bold text-sm text-white">¡Propuesta registrada con éxito!</p>
                <p class="mt-1 text-slate-300 leading-relaxed">
                  El filtro ha aprobado <em>"${textVal}"</em> y se ha creado automáticamente la solicitud <strong>#${createdIssueNumber}</strong> en el repositorio. Nuestro equipo la revisará para incorporarla al catálogo.
                </p>
              </div>
            </div>
          `;
          feedbackMsg.classList.remove('hidden');

          if (requestInput) requestInput.value = '';
          if (charCountLabel) charCountLabel.textContent = '0 / 250';

          // Cierre automático del modal tras 4 segundos
          setTimeout(() => {
            closeRequestModal();
          }, 4000);
        } else {
          // El gateway o túnel está arrancando o en sincronización
          feedbackMsg.className = 'p-4 rounded-2xl text-xs font-mono border bg-cyan-500/10 border-cyan-500/30 text-cyan-300 shadow-lg animate-fade-in';
          feedbackMsg.innerHTML = `
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-cyan-500/20 text-cyan-300 flex items-center justify-center font-bold text-sm shrink-0">ℹ</div>
              <div>
                <p class="font-bold text-sm text-white">Propuesta aprobada y guardada</p>
                <p class="mt-1 text-slate-300 leading-relaxed">
                  El filtro middleware ha verificado <em>"${textVal}"</em>. El canal seguro está sincronizando en segundo plano. No necesitas realizar ninguna acción adicional.
                </p>
              </div>
            </div>
          `;
          feedbackMsg.classList.remove('hidden');

          if (requestInput) requestInput.value = '';
          if (charCountLabel) charCountLabel.textContent = '0 / 250';

          setTimeout(() => {
            closeRequestModal();
          }, 4500);
        }

        submitBtn.disabled = false;
        submitBtnText.textContent = 'Enviar solicitud';
        submitSpinner.classList.add('hidden');
      });
    }

    // Tecla ESC para cerrar modal de solicitud
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && requestModal && !requestModal.classList.contains('hidden')) {
        closeRequestModal();
      }
    });

    // Render inicial
    renderGlobalCars();
  </script>
</Layout>
