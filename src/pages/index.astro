---
import Layout from '../layouts/Layout.astro';
import bmwCatalog from '../../data/bmw/catalog-clean-front.json';
import cupraCatalog from '../../data/cupra/catalog-clean-front.json';
import jaguarCatalog from '../../data/jaguar/catalog-clean-front.json';
import lexusCatalog from '../../data/lexus/catalog-clean-front.json';
import { BRANDS } from '../data/brands';
import requestsRegistry from '../../data/feedback/requests-registry.json';

// Preparación de datos multi-marca para el buscador global
const bmwCars = bmwCatalog.generations.map(g => ({
  id: g.id,
  brandId: 'bmw',
  brandName: 'BMW',
  brandLogo: '/carvault/images/brands/bmw.svg',
  label: g.label,
  series: g.series,
  section: g.section,
  status: g.status,
  isM: g.isM || g.series === 'BMW M' || (g.label && g.label.startsWith('M')),
  isVZ: false,
  isSVO: false,
  class: g.class,
  years: g.years,
  chassisCodes: g.chassis ? g.chassis.map((c: any) => c.code).filter(Boolean).join(', ') : '',
  frontImage: g.frontImage,
  brandCatalogUrl: '/carvault/bmw'
}));

const cupraCars = cupraCatalog.generations.map(g => ({
  id: g.id,
  brandId: 'cupra',
  brandName: 'CUPRA',
  brandLogo: '/carvault/images/brands/cupra.svg',
  label: g.label,
  series: g.series,
  section: g.section,
  status: g.status,
  isM: false,
  isVZ: (g.label && g.label.includes('VZ')) || (g.class && g.class.includes('VZ')),
  isSVO: false,
  class: g.class,
  years: g.years,
  chassisCodes: g.chassis ? g.chassis.map((c: any) => c.code).filter(Boolean).join(', ') : '',
  frontImage: g.frontImage,
  brandCatalogUrl: '/carvault/cupra'
}));

const jaguarCars = jaguarCatalog.generations.map(g => ({
  id: g.id,
  brandId: 'jaguar',
  brandName: 'Jaguar',
  brandLogo: '/carvault/images/brands/jaguar.svg',
  label: g.label,
  series: g.series,
  section: g.section,
  status: g.status,
  isM: false,
  isVZ: false,
  isSVO: g.series === 'Jaguar SVO' || (g.label && (g.label.includes('SVR') || g.label.includes('Project'))),
  class: g.class,
  years: g.years,
  chassisCodes: g.chassis ? g.chassis.map((c: any) => c.code).filter(Boolean).join(', ') : '',
  frontImage: g.frontImage,
  brandCatalogUrl: '/carvault/jaguar'
}));

const lexusCars = lexusCatalog.generations.map(g => ({
  id: g.id,
  brandId: 'lexus',
  brandName: 'Lexus',
  brandLogo: '/carvault/images/brands/lexus.svg',
  label: g.label,
  series: g.series,
  section: g.section,
  status: g.status,
  isM: false,
  isVZ: false,
  isSVO: false,
  isF: g.section === 'm-performance' || (g.label && (g.label.includes('IS F') || g.label.includes('RC F') || g.label.includes('GS F') || g.label.includes('LFA') || g.label.includes('F Sport'))),
  class: g.class,
  years: g.years,
  chassisCodes: g.chassis ? g.chassis.map((c: any) => c.code).filter(Boolean).join(', ') : '',
  frontImage: g.frontImage,
  brandCatalogUrl: '/carvault/lexus'
}));

const globalCars = [...bmwCars, ...cupraCars, ...jaguarCars, ...lexusCars];

const globalCarsJson = JSON.stringify(globalCars);

const brandsJson = JSON.stringify(BRANDS);
const registryJson = JSON.stringify(requestsRegistry);
---

<Layout title="Carvault — Cada coche y modelo desde su perspectiva frontal con API">
  <!-- Hero Section Escalable -->
  <section class="relative overflow-hidden pt-16 pb-16 border-b border-slate-900 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white max-w-5xl mx-auto leading-tight sm:leading-tight">
        Cada coche y modelo desde su <span class="bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-500 bg-clip-text text-transparent">perspectiva frontal</span> con disponibilidad de <a href="#api" class="text-cyan-400 hover:text-cyan-300 underline underline-offset-8 decoration-cyan-500/50 hover:decoration-cyan-400 font-mono transition-all">API</a>
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-400 max-w-3xl mx-auto leading-relaxed">
        Explora la historia automotriz con fotografías limpias de carrocería frontal en alta resolución. Búsqueda abierta por fabricante, décadas de producción y prototipos experimentales.
      </p>

      <!-- Botón Solicitud de Modelos / Marcas Faltantes (Prominente y Visible) -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 p-4 sm:p-5 rounded-2xl bg-slate-900/90 border border-slate-800 shadow-2xl max-w-2xl mx-auto backdrop-blur-md">
        <span class="text-sm sm:text-base font-semibold text-slate-200 tracking-wide text-center sm:text-left">
          ¿Echas en falta algún modelo? ¿Alguna marca?
        </span>
        <button 
          id="openRequestModalBtn"
          class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-black text-xs sm:text-sm tracking-wide transition-all duration-300 cursor-pointer shadow-lg shadow-cyan-500/25 hover:shadow-cyan-400/40 hover:scale-[1.03] flex items-center gap-2 group shrink-0"
        >
          <span>Haznoslo saber</span>
          <span class="text-base group-hover:translate-x-1 transition-transform">→</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Buscador Genérico Global Multi-Marca -->
  <section id="global-search" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="bg-slate-900/80 p-5 sm:p-7 rounded-3xl border border-slate-800 backdrop-blur-md mb-8 shadow-2xl space-y-6">
      <!-- 1. Input de Búsqueda Global -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="globalSearchInput" class="text-xs font-mono text-slate-400 uppercase tracking-wider flex items-center gap-2">
            <span>Buscador General Multi-Marca</span>
            <span class="text-[10px] text-slate-500 font-sans hidden sm:inline">(busca coches de cualquier fabricante o modelo)</span>
          </label>
          <span class="hidden sm:inline-block text-[11px] font-mono text-slate-500">Pulsa <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700 text-[10px]">/</kbd> para buscar</span>
        </div>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <input 
            id="globalSearchInput"
            type="text" 
            placeholder="Busca cualquier coche o modelo... (ej. M3, E46, Carrera, 911, Z4, 320i, Diablo, Skytop...)" 
            class="w-full bg-slate-950 border border-slate-700/80 rounded-xl pl-10 pr-10 py-3 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400/40 transition-all font-mono"
            autocomplete="off"
          />
          <button 
            id="globalClearSearchBtn" 
            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-500 hover:text-slate-300 transition-colors hidden cursor-pointer"
            title="Limpiar búsqueda"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>

      <!-- 2. Filtros Genéricos (Marca, Época / Intervalo Años, Conceptos y Ordenar Por) -->
      <div class="pt-4 border-t border-slate-800/80">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Filtro: Marca / Fabricante (Escalable para futuras marcas) -->
          <div>
            <label for="globalBrandSelect" class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">
              Marca / Fabricante
            </label>
            <select id="globalBrandSelect" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400/40 transition-colors cursor-pointer">
              <option value="all">Todas las marcas (Cualquiera)</option>
              {BRANDS.map(b => (
                <option value={b.id}>{b.name}</option>
              ))}
            </select>
          </div>

          <!-- Filtro: Época / Intervalo Años -->
          <div>
            <label for="globalEraSelect" class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">
              Época / Intervalo Años
            </label>
            <select id="globalEraSelect" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400/40 transition-colors cursor-pointer">
              <option value="all">Todos los Años (1927 - 2026)</option>
              <option value="2020-present">2020 - 2026 (Era Moderna & Eléctricos)</option>
              <option value="2010-2019">2010 - 2019 (Era 2010s)</option>
              <option value="2000-2009">2000 - 2009 (Era 2000s)</option>
              <option value="1990-1999">1990 - 1999 (Era Dorada 1990s)</option>
              <option value="1980-1989">1980 - 1989 (Youngtimers 1980s)</option>
              <option value="1960-1979">1960 - 1979 (Clásicos Vintage)</option>
              <option value="pre-1960">1927 - 1959 (Pioneros e Históricos)</option>
              <option value="custom">Rango Personalizado...</option>
            </select>
          </div>

          <!-- Filtro: Conceptos & Prototipos -->
          <div>
            <label for="globalConceptSelect" class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">
              Tipo de Modelo
            </label>
            <select id="globalConceptSelect" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400/40 transition-colors cursor-pointer">
              <option value="all">Todos los Vehículos</option>
              <option value="production">Solo Modelos de Producción en Serie</option>
              <option value="prototypes">Solo Conceptos & Prototipos</option>
            </select>
          </div>

          <!-- Filtro: Ordenar Por -->
          <div>
            <label for="globalSortSelect" class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">
              Ordenar Por
            </label>
            <select id="globalSortSelect" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400/40 transition-colors cursor-pointer">
              <option value="year-desc">Más recientes primero (Año ↓)</option>
              <option value="year-asc">Más antiguos primero (Año ↑)</option>
              <option value="name-asc">Nombre del modelo (A - Z)</option>
            </select>
          </div>
        </div>

        <!-- Rango de Años Personalizado (se muestra al elegir custom) -->
        <div id="globalCustomYearsContainer" class="hidden mt-3 pt-3 border-t border-slate-800/60 flex flex-wrap items-center gap-3 bg-slate-950/60 p-3 rounded-xl">
          <span class="text-xs font-mono text-slate-400">Intervalo de Años Específico:</span>
          <div class="flex items-center gap-2">
            <span class="text-xs text-slate-500 font-mono">Desde:</span>
            <input type="number" id="globalYearFromInput" min="1927" max="2026" placeholder="1990" class="w-24 bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1 text-xs text-slate-200 font-mono focus:outline-none focus:border-cyan-400" />
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs text-slate-500 font-mono">Hasta:</span>
            <input type="number" id="globalYearToInput" min="1927" max="2026" placeholder="2006" class="w-24 bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1 text-xs text-slate-200 font-mono focus:outline-none focus:border-cyan-400" />
          </div>
          <button id="globalApplyYearsBtn" class="px-3 py-1 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold text-xs transition-colors cursor-pointer">Aplicar</button>
        </div>
      </div>

      <!-- Barra de Estado y Botón Reset -->
      <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between">
        <span class="text-xs font-mono text-slate-400" id="globalResultsCount">Cargando base de datos global...</span>
        <button 
          id="globalResetFiltersBtn" 
          class="hidden items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-red-500/20 hover:text-red-300 hover:border-red-500/40 border border-slate-700 text-slate-300 transition-all cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span>Limpiar filtros</span>
        </button>
      </div>
    </div>

    <!-- Grid de Resultados de Búsqueda Global -->
    <div id="globalModelsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Inyectado por JS -->
    </div>

    <!-- Estado Inicial: Invita a buscar o seleccionar marca -->
    <div id="globalInitialState" class="text-center py-12 px-6 bg-slate-900/40 border border-slate-800/80 rounded-3xl max-w-xl mx-auto shadow-xl">
      <div class="w-14 h-14 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center mx-auto mb-3 text-2xl">
        ⌨️
      </div>
      <h3 class="text-base font-bold text-white">Escribe en el buscador para ver vehículos coincidentes</h3>
      <p class="text-xs text-slate-400 mt-2 max-w-md mx-auto leading-relaxed">
        Para mantener una navegación rápida y limpia, las imágenes de los modelos se cargan únicamente cuando buscas un coche o si pulsas una marca específica a continuación para abrir su catálogo completo.
      </p>
    </div>

    <!-- Empty State -->
    <div id="globalEmptyState" class="hidden text-center py-12 px-4 bg-slate-900/40 border border-slate-800 rounded-3xl max-w-md mx-auto">
      <div class="w-14 h-14 rounded-2xl bg-slate-800/80 border border-slate-700 flex items-center justify-center mx-auto mb-3 text-slate-400 text-xl">
        🔍
      </div>
      <h3 class="text-base font-bold text-white">No se encontraron vehículos coincidentes</h3>
      <p class="text-xs text-slate-400 mt-1.5 max-w-xs mx-auto leading-relaxed">
        Prueba con otros términos de búsqueda o restablece los filtros de época.
      </p>
      <button id="globalEmptyResetBtn" class="mt-4 px-3.5 py-1.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs transition-colors cursor-pointer">
        Restablecer filtros
      </button>
    </div>
  </section>

  <!-- Sección: Marcas disponibles actualmente -->
  <section id="marcas" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-900">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium border border-cyan-500/30 bg-cyan-500/10 text-cyan-300 mb-3">
        Ecosistema Escalable de Fabricantes
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Marcas disponibles actualmente
      </h2>
      <p class="mt-2 text-sm text-slate-400">
        Haz clic en una marca para acceder a su catálogo monomarca completo con selector de códigos de chasis, variantes mecánicas y filtros de serie avanzados.
      </p>
    </div>

    <!-- Grid de Marcas Disponibles -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Tarjeta BMW -->
      <a 
        href="/carvault/bmw" 
        class="group bg-gradient-to-b from-slate-900/90 to-slate-950 border border-slate-800 hover:border-cyan-500/60 rounded-3xl p-7 transition-all duration-300 flex flex-col items-center text-center hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-cyan-500/10 relative overflow-hidden"
      >
        <div class="absolute top-3 right-3">
          <span class="px-2.5 py-0.5 rounded-md bg-emerald-600 text-white text-[10px] font-bold tracking-wide shadow-sm">
            Disponible
          </span>
        </div>

        <!-- Icono / Logo oficial de la marca -->
        <div class="w-24 h-24 rounded-full bg-slate-950 border border-slate-800 p-3 flex items-center justify-center shadow-xl group-hover:scale-105 transition-transform duration-300 mb-4">
          <img src="/carvault/images/brands/bmw.svg" alt="Logo de BMW" class="w-full h-full object-contain" />
        </div>

        <!-- Nombre de la marca -->
        <h3 class="text-2xl font-black text-white group-hover:text-cyan-300 transition-colors tracking-wide">
          BMW
        </h3>
        <p class="text-xs text-slate-400 font-mono mt-0.5">Bayerische Motoren Werke</p>
        <p class="text-xs text-slate-500 mt-2 line-clamp-2">
          Catálogo integral con vista frontal limpia: Serie 1 a 8, Gama X, Roadsters Z y división BMW M Motorsport.
        </p>

        <!-- Botón de Acción -->
        <div class="mt-5 inline-flex items-center gap-2 text-xs font-bold text-cyan-400 group-hover:text-cyan-300 group-hover:underline">
          <span>Abrir catálogo completo de BMW</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>

      <!-- Tarjeta CUPRA -->
      <a 
        href="/carvault/cupra" 
        class="group bg-gradient-to-b from-slate-900/90 to-slate-950 border border-slate-800 hover:border-amber-500/60 rounded-3xl p-7 transition-all duration-300 flex flex-col items-center text-center hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-amber-500/10 relative overflow-hidden"
      >
        <div class="absolute top-3 right-3">
          <span class="px-2.5 py-0.5 rounded-md bg-emerald-600 text-white text-[10px] font-bold tracking-wide shadow-sm">
            Disponible
          </span>
        </div>

        <!-- Icono / Logo oficial de la marca -->
        <div class="w-24 h-24 rounded-full bg-slate-950 border border-slate-800 p-3 flex items-center justify-center shadow-xl group-hover:scale-105 transition-transform duration-300 mb-4">
          <img src="/carvault/images/brands/cupra.svg" alt="Logo de CUPRA" class="w-full h-full object-contain" />
        </div>

        <!-- Nombre de la marca -->
        <h3 class="text-2xl font-black text-white group-hover:text-amber-400 transition-colors tracking-wide">
          CUPRA
        </h3>
        <p class="text-xs text-slate-400 font-mono mt-0.5">SEAT Cupra, S.A.U.</p>
        <p class="text-xs text-slate-500 mt-2 line-clamp-2">
          Deportivos de altas prestaciones: Formentor VZ5 (5 cilindros), León Mk4, Ateca, Born BEV y la nueva era Shark Nose con Tavascan y Terramar.
        </p>

        <!-- Botón de Acción -->
        <div class="mt-5 inline-flex items-center gap-2 text-xs font-bold text-amber-400 group-hover:text-amber-300 group-hover:underline">
          <span>Abrir catálogo completo de CUPRA</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>

      <!-- Tarjeta Jaguar -->
      <a 
        href="/carvault/jaguar" 
        class="group bg-gradient-to-b from-slate-900/90 to-slate-950 border border-slate-800 hover:border-emerald-500/60 rounded-3xl p-7 transition-all duration-300 flex flex-col items-center text-center hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-emerald-500/10 relative overflow-hidden"
      >
        <div class="absolute top-3 right-3">
          <span class="px-2.5 py-0.5 rounded-md bg-emerald-600 text-white text-[10px] font-bold tracking-wide shadow-sm">
            Disponible
          </span>
        </div>

        <!-- Icono / Logo oficial de la marca -->
        <div class="w-24 h-24 rounded-full bg-slate-950 border border-slate-800 p-3 flex items-center justify-center shadow-xl group-hover:scale-105 transition-transform duration-300 mb-4">
          <img src="/carvault/images/brands/jaguar.svg" alt="Logo de Jaguar" class="w-full h-full object-contain" />
        </div>

        <!-- Nombre de la marca -->
        <h3 class="text-2xl font-black text-white group-hover:text-emerald-400 transition-colors tracking-wide">
          Jaguar
        </h3>
        <p class="text-xs text-slate-400 font-mono mt-0.5">Jaguar Cars Ltd. / JLR</p>
        <p class="text-xs text-slate-500 mt-2 line-clamp-2">
          Deportividad británica y herencia: F-Type V8 Supercharged, sagas XK y XJ, berlinas XF/XE, Project 7/8 y leyendas como el XJ220 y el E-Type.
        </p>

        <!-- Botón de Acción -->
        <div class="mt-5 inline-flex items-center gap-2 text-xs font-bold text-emerald-400 group-hover:text-emerald-300 group-hover:underline">
          <span>Abrir catálogo completo de Jaguar</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>

      <!-- Tarjeta Lexus -->
      <a 
        href="/carvault/lexus" 
        class="group bg-gradient-to-b from-slate-900/90 to-slate-950 border border-slate-800 hover:border-amber-500/60 rounded-3xl p-7 transition-all duration-300 flex flex-col items-center text-center hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-amber-500/10 relative overflow-hidden"
      >
        <div class="absolute top-3 right-3">
          <span class="px-2.5 py-0.5 rounded-md bg-emerald-600 text-white text-[10px] font-bold tracking-wide shadow-sm">
            Disponible
          </span>
        </div>

        <!-- Icono / Logo oficial de la marca -->
        <div class="w-24 h-24 rounded-full bg-slate-950 border border-slate-800 p-3 flex items-center justify-center shadow-xl group-hover:scale-105 transition-transform duration-300 mb-4">
          <img src="/carvault/images/brands/lexus.svg" alt="Logo de Lexus" class="w-full h-full object-contain" />
        </div>

