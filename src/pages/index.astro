---
import Layout from '../layouts/Layout.astro';
import catalog from '../../data/bmw/catalog-clean-front.json';
import { BRANDS } from '../data/brands';

// Preparación de datos multi-marca para el buscador global
const globalCars = catalog.generations.map(g => ({
  id: g.id,
  brandId: 'bmw',
  brandName: 'BMW',
  brandLogo: '/images/brands/bmw.svg',
  label: g.label,
  series: g.series,
  section: g.section,
  status: g.status,
  isM: g.isM || g.series === 'BMW M' || (g.label && g.label.startsWith('M')),
  class: g.class,
  years: g.years,
  chassisCodes: g.chassis ? g.chassis.map(c => c.code).filter(Boolean).join(', ') : '',
  frontImage: g.frontImage,
  brandCatalogUrl: '/bmw'
}));

const globalCarsJson = JSON.stringify(globalCars);
const brandsJson = JSON.stringify(BRANDS);
---

<Layout title="Carvault — Cada coche y modelo desde su perspectiva frontal con API">
  <!-- Hero Section Escalable -->
  <section class="relative overflow-hidden pt-16 pb-16 border-b border-slate-900 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white max-w-5xl mx-auto leading-tight sm:leading-tight">
        Cada coche y modelo desde su <span class="bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-500 bg-clip-text text-transparent">perspectiva frontal</span> con disponibilidad de <a href="#api" class="text-cyan-400 hover:text-cyan-300 underline underline-offset-8 decoration-cyan-500/50 hover:decoration-cyan-400 font-mono transition-all">API</a>
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-400 max-w-3xl mx-auto leading-relaxed">
        Explora la historia automotriz con fotografías limpias de carrocería frontal en alta resolución. Búsqueda abierta por fabricante, décadas de producción y prototipos experimentales.
      </p>
    </div>
  </section>

  <!-- Buscador Genérico Global Multi-Marca -->
  <section id="global-search" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="bg-slate-900/80 p-5 sm:p-7 rounded-3xl border border-slate-800 backdrop-blur-md mb-8 shadow-2xl space-y-6">
      <!-- 1. Input de Búsqueda Global -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="globalSearchInput" class="text-xs font-mono text-slate-400 uppercase tracking-wider flex items-center gap-2">
            <span>Buscador General Multi-Marca</span>
            <span class="text-[10px] text-slate-500 font-sans hidden sm:inline">(busca coches de cualquier fabricante o modelo)</span>
          </label>
          <span class="hidden sm:inline-block text-[11px] font-mono text-slate-500">Pulsa <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700 text-[10px]">/</kbd> para buscar</span>
        </div>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <input 
            id="globalSearchInput"
            type="text" 
            placeholder="Busca cualquier coche o modelo... (ej. M3, E46, Carrera, 911, Z4, 320i, Diablo, Skytop...)" 
            class="w-full bg-slate-950 border border-slate-700/80 rounded-xl pl-10 pr-10 py-3 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400/40 transition-all font-mono"
            autocomplete="off"
          />
          <button 
            id="globalClearSearchBtn" 
            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-500 hover:text-slate-300 transition-colors hidden cursor-pointer"
            title="Limpiar búsqueda"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>

      <!-- 2. Filtros Genéricos (Únicamente Época / Intervalo Años, Ordenar Por y Conceptos) -->
      <div class="pt-4 border-t border-slate-800/80">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- Filtro: Época / Intervalo Años -->
          <div>
            <label for="globalEraSelect" class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">
              Época / Intervalo Años
            </label>
            <select id="globalEraSelect" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400/40 transition-colors">
              <option value="all">Todos los Años (1927 - 2026)</option>
              <option value="2020-present">2020 - 2026 (Era Moderna & Eléctricos)</option>
              <option value="2010-2019">2010 - 2019 (Era 2010s)</option>
              <option value="2000-2009">2000 - 2009 (Era 2000s)</option>
              <option value="1990-1999">1990 - 1999 (Era Dorada 1990s)</option>
              <option value="1980-1989">1980 - 1989 (Youngtimers 1980s)</option>
              <option value="1960-1979">1960 - 1979 (Clásicos Vintage)</option>
              <option value="pre-1960">1927 - 1959 (Pioneros e Históricos)</option>
              <option value="custom">Rango Personalizado...</option>
            </select>
          </div>

          <!-- Filtro: Conceptos & Prototipos -->
          <div>
            <label for="globalConceptSelect" class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">
              Tipo de Modelo
            </label>
            <select id="globalConceptSelect" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400/40 transition-colors">
              <option value="all">Todos los Vehículos</option>
              <option value="production">Solo Modelos de Producción en Serie</option>
              <option value="prototypes">Solo Conceptos & Prototipos</option>
            </select>
          </div>

          <!-- Filtro: Ordenar Por -->
          <div>
            <label for="globalSortSelect" class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">
              Ordenar Por
            </label>
            <select id="globalSortSelect" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400/40 transition-colors">
              <option value="year-desc">Más recientes primero (Año ↓)</option>
              <option value="year-asc">Más antiguos primero (Año ↑)</option>
              <option value="name-asc">Nombre del modelo (A - Z)</option>
            </select>
          </div>
        </div>

        <!-- Rango de Años Personalizado (se muestra al elegir custom) -->
        <div id="globalCustomYearsContainer" class="hidden mt-3 pt-3 border-t border-slate-800/60 flex flex-wrap items-center gap-3 bg-slate-950/60 p-3 rounded-xl">
          <span class="text-xs font-mono text-slate-400">Intervalo de Años Específico:</span>
          <div class="flex items-center gap-2">
            <span class="text-xs text-slate-500 font-mono">Desde:</span>
            <input type="number" id="globalYearFromInput" min="1927" max="2026" placeholder="1990" class="w-24 bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1 text-xs text-slate-200 font-mono focus:outline-none focus:border-cyan-400" />
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs text-slate-500 font-mono">Hasta:</span>
            <input type="number" id="globalYearToInput" min="1927" max="2026" placeholder="2006" class="w-24 bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1 text-xs text-slate-200 font-mono focus:outline-none focus:border-cyan-400" />
          </div>
          <button id="globalApplyYearsBtn" class="px-3 py-1 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold text-xs transition-colors cursor-pointer">Aplicar</button>
        </div>
      </div>

      <!-- Barra de Estado y Botón Reset -->
      <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between">
        <span class="text-xs font-mono text-slate-400" id="globalResultsCount">Cargando base de datos global...</span>
        <button 
          id="globalResetFiltersBtn" 
          class="hidden items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-red-500/20 hover:text-red-300 hover:border-red-500/40 border border-slate-700 text-slate-300 transition-all cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span>Limpiar filtros</span>
        </button>
      </div>
    </div>

    <!-- Grid de Resultados de Búsqueda Global -->
    <div id="globalModelsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Inyectado por JS -->
    </div>

    <!-- Empty State -->
    <div id="globalEmptyState" class="hidden text-center py-12 px-4 bg-slate-900/40 border border-slate-800 rounded-3xl max-w-md mx-auto">
      <div class="w-14 h-14 rounded-2xl bg-slate-800/80 border border-slate-700 flex items-center justify-center mx-auto mb-3 text-slate-400 text-xl">
        🔍
      </div>
      <h3 class="text-base font-bold text-white">No se encontraron vehículos coincidentes</h3>
      <p class="text-xs text-slate-400 mt-1.5 max-w-xs mx-auto leading-relaxed">
        Prueba con otros términos de búsqueda o restablece los filtros de época.
      </p>
      <button id="globalEmptyResetBtn" class="mt-4 px-3.5 py-1.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs transition-colors cursor-pointer">
        Restablecer filtros
      </button>
    </div>
  </section>

  <!-- Sección: Marcas disponibles actualmente -->
  <section id="marcas" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-900">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium border border-cyan-500/30 bg-cyan-500/10 text-cyan-300 mb-3">
        Ecosistema Escalable de Fabricantes
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Marcas disponibles actualmente
      </h2>
      <p class="mt-2 text-sm text-slate-400">
        Haz clic en una marca para acceder a su catálogo monomarca completo con selector de códigos de chasis, variantes mecánicas y filtros de serie avanzados.
      </p>
    </div>

    <!-- Grid de Marcas Disponibles -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <!-- Tarjeta BMW -->
      <a 
        href="/bmw" 
        class="group bg-gradient-to-b from-slate-900/90 to-slate-950 border border-slate-800 hover:border-cyan-500/60 rounded-3xl p-7 transition-all duration-300 flex flex-col items-center text-center hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-cyan-500/10 relative overflow-hidden"
      >
        <div class="absolute top-3 right-3">
          <span class="px-2.5 py-0.5 rounded-md bg-emerald-600 text-white text-[10px] font-bold tracking-wide shadow-sm">
            Disponible
          </span>
        </div>

        <!-- Icono / Logo oficial de la marca -->
        <div class="w-24 h-24 rounded-full bg-slate-950 border border-slate-800 p-3 flex items-center justify-center shadow-xl group-hover:scale-105 transition-transform duration-300 mb-4">
          <img src="/images/brands/bmw.svg" alt="Logo de BMW" class="w-full h-full object-contain" />
        </div>

        <!-- Nombre de la marca -->
        <h3 class="text-2xl font-black text-white group-hover:text-cyan-300 transition-colors tracking-wide">
          BMW
        </h3>
        <p class="text-xs text-slate-400 font-mono mt-0.5">Bayerische Motoren Werke</p>
        <p class="text-xs text-slate-500 mt-2 line-clamp-2">
          Catálogo integral con vista frontal limpia: Serie 1 a 8, Gama X, Roadsters Z y división BMW M Motorsport.
        </p>

        <!-- Botón de Acción -->
        <div class="mt-5 inline-flex items-center gap-2 text-xs font-bold text-cyan-400 group-hover:text-cyan-300 group-hover:underline">
          <span>Abrir catálogo completo de BMW</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>

      <!-- Tarjeta Próximamente: Porsche -->
      <div class="bg-slate-900/30 border border-slate-850 rounded-3xl p-7 flex flex-col items-center text-center opacity-60">
        <div class="w-24 h-24 rounded-full bg-slate-950/60 border border-slate-800/60 p-4 flex items-center justify-center mb-4">
          <span class="text-2xl font-black text-slate-600 font-mono">P</span>
        </div>
        <h3 class="text-2xl font-bold text-slate-400 tracking-wide">Porsche</h3>
        <p class="text-xs text-slate-500 font-mono mt-0.5">Stuttgart, Alemania</p>
        <span class="mt-3 px-2.5 py-0.5 rounded-md bg-slate-800 text-slate-400 text-[10px] font-mono">
          Próximamente en catálogo
        </span>
      </div>

      <!-- Tarjeta Próximamente: Mercedes-Benz -->
      <div class="bg-slate-900/30 border border-slate-850 rounded-3xl p-7 flex flex-col items-center text-center opacity-60">
        <div class="w-24 h-24 rounded-full bg-slate-950/60 border border-slate-800/60 p-4 flex items-center justify-center mb-4">
          <span class="text-2xl font-black text-slate-600 font-mono">MB</span>
        </div>
        <h3 class="text-2xl font-bold text-slate-400 tracking-wide">Mercedes-Benz</h3>
        <p class="text-xs text-slate-500 font-mono mt-0.5">Stuttgart, Alemania</p>
        <span class="mt-3 px-2.5 py-0.5 rounded-md bg-slate-800 text-slate-400 text-[10px] font-mono">
          Próximamente en catálogo
        </span>
      </div>
    </div>

    <!-- Panel de Estadísticas de la Marca (cambian según marca) -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-8 max-w-5xl mx-auto shadow-2xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-slate-950 border border-slate-800 p-1.5 flex items-center justify-center shrink-0">
            <img src="/images/brands/bmw.svg" alt="BMW" class="w-full h-full object-contain" />
          </div>
          <div>
            <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">Estadísticas Verificadas</span>
            <h4 class="text-lg font-bold text-white">Marca Seleccionada: BMW</h4>
          </div>
        </div>
        <a 
          href="/bmw" 
          class="px-4 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs transition-colors flex items-center gap-2 shrink-0 justify-center shadow-lg shadow-cyan-500/20"
        >
          <span>Ir al Catálogo & Buscador BMW</span>
          <span>→</span>
        </a>
      </div>

      <!-- Cuadrícula de Métricas Solicitadas -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 pt-6 text-center">
        <!-- 200 Modelos & Versiones -->
        <div class="flex flex-col items-center p-3 rounded-2xl bg-slate-950/60 border border-slate-800/80">
          <span class="text-3xl sm:text-4xl font-black text-white font-mono">200</span>
          <span class="text-xs text-slate-400 uppercase tracking-wider mt-1.5 font-medium">Modelos & Versiones</span>
        </div>

        <!-- 37 Gama BMW M -->
        <div class="flex flex-col items-center p-3 rounded-2xl bg-slate-950/60 border border-slate-800/80">
          <span class="text-3xl sm:text-4xl font-black text-red-500 font-mono">37</span>
          <span class="text-xs text-slate-400 uppercase tracking-wider mt-1.5 font-medium">Gama BMW M</span>
        </div>

        <!-- 279 Chasis Distintos -->
        <div class="flex flex-col items-center p-3 rounded-2xl bg-slate-950/60 border border-slate-800/80">
          <span class="text-3xl sm:text-4xl font-black text-cyan-400 font-mono">279</span>
          <span class="text-xs text-slate-400 uppercase tracking-wider mt-1.5 font-medium">Chasis Distintos</span>
        </div>

        <!-- 200 Frontales con Foto (100%) -->
        <div class="flex flex-col items-center p-3 rounded-2xl bg-slate-950/60 border border-slate-800/80">
          <span class="text-3xl sm:text-4xl font-black text-emerald-400 font-mono">200</span>
          <span class="text-xs text-slate-400 uppercase tracking-wider mt-1.5 font-medium">Frontales con Foto (100%)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección API Pública -->
  <section id="api" class="border-t border-slate-900 bg-slate-950 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">API Pública & Gratuita Carvault</h2>
        <p class="mt-2 text-sm text-slate-400">
          Disponibilidad inmediata de endpoints abiertos para alimentar tus aplicaciones con datos automotrices y fotografías frontales limpias.
        </p>
      </div>

      <div class="mt-8 max-w-3xl mx-auto bg-slate-900 border border-slate-800 rounded-2xl p-6 font-mono text-xs">
        <div class="flex items-center justify-between text-slate-400 pb-3 border-b border-slate-800">
          <span>GET Endpoint BMW Completo (Incluye Gama M)</span>
          <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[10px]">CORS Habilitado • $0 Coste</span>
        </div>
        <div class="mt-4 text-cyan-300 flex items-center justify-between bg-slate-950 p-3 rounded-lg border border-slate-800">
          <code>GET /api/v1/bmw.json</code>
          <a href="/api/v1/bmw.json" target="_blank" class="text-xs text-slate-400 hover:text-white px-2 py-1 rounded bg-slate-800 transition-colors">
            Probar JSON en vivo ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox Pantalla Completa para la Home -->
  <div id="homeLightbox" class="fixed inset-0 z-[60] bg-black/95 backdrop-blur-xl hidden flex items-center justify-center p-4 sm:p-8 animate-fade-in">
    <button id="closeHomeLightbox" class="absolute top-5 right-5 z-20 p-3 rounded-full bg-slate-800/80 hover:bg-red-500/80 text-white transition-all shadow-xl hover:scale-110 flex items-center justify-center cursor-pointer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <div class="relative max-w-6xl max-h-[90vh] w-full flex flex-col items-center justify-center">
      <img id="homeLightboxImg" src="" alt="Vista ampliada" class="max-h-[80vh] max-w-full object-contain rounded-xl shadow-2xl border border-slate-800/80" />
      <div class="mt-4 text-center">
        <h4 id="homeLightboxTitle" class="text-white font-bold text-base sm:text-lg"></h4>
        <p id="homeLightboxSubtitle" class="text-xs font-mono text-slate-400 mt-1"></p>
      </div>
    </div>
  </div>

  <!-- Script Cliente del Buscador Global -->
  <script is:inline define:vars={{ globalCarsJson, brandsJson }}>
    const allCars = JSON.parse(globalCarsJson);
    const brands = JSON.parse(brandsJson);

    let globalSearchQuery = '';
    let globalEra = 'all';
    let globalConcept = 'all';
    let globalSort = 'year-desc';
    let globalCustomYearFrom = null;
    let globalCustomYearTo = null;

    // DOM
    const grid = document.getElementById('globalModelsGrid');
    const searchInput = document.getElementById('globalSearchInput');
    const clearSearchBtn = document.getElementById('globalClearSearchBtn');
    const eraSelect = document.getElementById('globalEraSelect');
    const conceptSelect = document.getElementById('globalConceptSelect');
    const sortSelect = document.getElementById('globalSortSelect');
    const customYearsContainer = document.getElementById('globalCustomYearsContainer');
    const yearFromInput = document.getElementById('globalYearFromInput');
    const yearToInput = document.getElementById('globalYearToInput');
    const applyYearsBtn = document.getElementById('globalApplyYearsBtn');
    const resultsCount = document.getElementById('globalResultsCount');
    const resetFiltersBtn = document.getElementById('globalResetFiltersBtn');
    const emptyState = document.getElementById('globalEmptyState');
    const emptyResetBtn = document.getElementById('globalEmptyResetBtn');

    // Lightbox
    const lightbox = document.getElementById('homeLightbox');
    const lightboxImg = document.getElementById('homeLightboxImg');
    const lightboxTitle = document.getElementById('homeLightboxTitle');
    const lightboxSubtitle = document.getElementById('homeLightboxSubtitle');
    const closeLightbox = document.getElementById('closeHomeLightbox');

    window.openHomeLightbox = function(url, title, subtitle) {
      if (!url) return;
      lightboxImg.src = url;
      lightboxTitle.textContent = title || '';
      lightboxSubtitle.textContent = subtitle || '';
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };

    function closeHomeLightboxModal() {
      lightbox.classList.add('hidden');
      lightboxImg.src = '';
      document.body.style.overflow = '';
    }

    closeLightbox.addEventListener('click', closeHomeLightboxModal);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === lightboxImg.parentElement) {
        closeHomeLightboxModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
        closeHomeLightboxModal();
      }
    });

    // Atajo "/"
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'SELECT') {
        e.preventDefault();
        searchInput.focus();
      }
    });

    function matchesEra(c, eraVal) {
      if (eraVal === 'all') return true;
      const start = c.years?.start || 0;
      const end = c.years?.end || start;

      if (eraVal === '2020-present') return end >= 2020;
      if (eraVal === '2010-2019') return start <= 2019 && end >= 2010;
      if (eraVal === '2000-2009') return start <= 2009 && end >= 2000;
      if (eraVal === '1990-1999') return start <= 1999 && end >= 1990;
      if (eraVal === '1980-1989') return start <= 1989 && end >= 1980;
      if (eraVal === '1960-1979') return start <= 1979 && end >= 1960;
      if (eraVal === 'pre-1960') return start < 1960;
      if (eraVal === 'custom') {
        const from = globalCustomYearFrom || 1927;
        const to = globalCustomYearTo || 2026;
        return start <= to && end >= from;
      }
      return true;
    }

    function renderGlobalCars() {
      // Indicador de filtros activos
      let activeCount = 0;
      if (globalSearchQuery) activeCount++;
      if (globalEra !== 'all') activeCount++;
      if (globalConcept !== 'all') activeCount++;
      if (globalSort !== 'year-desc') activeCount++;

      if (activeCount > 0) {
        resetFiltersBtn.classList.remove('hidden');
        resetFiltersBtn.classList.add('inline-flex');
      } else {
        resetFiltersBtn.classList.add('hidden');
        resetFiltersBtn.classList.remove('inline-flex');
      }

      const filtered = allCars.filter(c => {
        // Filtro Conceptos
        if (globalConcept === 'production' && c.section === 'prototypes') return false;
        if (globalConcept === 'prototypes' && c.section !== 'prototypes') return false;

        // Filtro Época
        if (!matchesEra(c, globalEra)) return false;

        // Búsqueda por Texto
        if (globalSearchQuery) {
          const tokens = globalSearchQuery.toLowerCase().split(/\s+/).filter(Boolean);
          const fullText = `${c.label || ''} ${c.brandName || ''} ${c.series || ''} ${c.class || ''} ${c.chassisCodes || ''} ${c.years?.display || ''}`.toLowerCase();
          const matchAll = tokens.every(tok => fullText.includes(tok));
          if (!matchAll) return false;
        }

        return true;
      });

      // Ordenación
      filtered.sort((a, b) => {
        if (globalSort === 'year-desc') return (b.years?.start || 0) - (a.years?.start || 0);
        if (globalSort === 'year-asc') return (a.years?.start || 0) - (b.years?.start || 0);
        if (globalSort === 'name-asc') return a.label.localeCompare(b.label);
        return 0;
      });

      resultsCount.textContent = `Mostrando ${filtered.length} de ${allCars.length} coches disponibles`;

      if (filtered.length === 0) {
        grid.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      } else {
        emptyState.classList.add('hidden');
      }

      grid.innerHTML = filtered.map(c => {
        const isM = c.isM;
        const isCurrent = c.status === 'current';
        const isProto = c.section === 'prototypes';

        return `
          <div class="bg-slate-900/60 border ${isM ? 'border-indigo-500/40 hover:border-indigo-400' : 'border-slate-800 hover:border-cyan-500/50'} rounded-2xl overflow-hidden transition-all duration-300 flex flex-col group hover:-translate-y-1 shadow-lg">
            <div class="aspect-[16/10] bg-slate-950 relative overflow-hidden flex items-center justify-center group/img">
              ${c.frontImage?.url 
                ? `<img src="${c.frontImage.url}" alt="${c.label}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                   <button 
                     onclick="event.stopPropagation(); openHomeLightbox('${c.frontImage.url}', '${c.label.replace(/'/g, "\\'")}', '${c.brandName} • ${(c.years?.display || '').replace(/'/g, "\\'")}')" 
                     class="absolute bottom-2.5 right-2.5 p-2 rounded-xl bg-slate-950/80 hover:bg-cyan-500 text-slate-300 hover:text-slate-950 backdrop-blur-md border border-slate-700/80 hover:border-cyan-400 transition-all opacity-0 group-hover:opacity-100 flex items-center gap-1.5 text-xs font-mono shadow-lg cursor-pointer"
                     title="Ver imagen completa sin recortes"
                   >
                     <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
                     <span class="text-[11px] font-semibold">Ampliar</span>
                   </button>`
                : `<div class="text-slate-600 text-xs font-mono">Sin foto frontal</div>`
              }
              <div class="absolute top-3 left-3 flex items-center gap-1.5 flex-wrap">
                <span class="px-2 py-0.5 rounded-md bg-slate-950 text-slate-200 border border-slate-800 text-[10px] font-bold font-mono flex items-center gap-1">
                  <img src="${c.brandLogo}" class="w-3.5 h-3.5" alt="${c.brandName}" />
                  ${c.brandName}
                </span>
                ${isM ? `
                  <span class="px-2 py-0.5 rounded-md bg-red-600 text-white text-[10px] font-black uppercase tracking-wider shadow-sm">
                    M
                  </span>
                ` : ''}
                ${isCurrent ? `
                  <span class="px-2 py-0.5 rounded-md bg-emerald-600 text-white text-[10px] font-bold shadow-sm">
                    Actual
                  </span>
                ` : ''}
                ${isProto ? `
                  <span class="px-2 py-0.5 rounded-md bg-amber-600 text-white text-[10px] font-bold shadow-sm">
                    Concepto
                  </span>
                ` : ''}
              </div>
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs text-slate-500 font-mono mb-1.5">
                  <span class="bg-slate-800/80 px-2 py-0.5 rounded border border-slate-700/60 text-slate-300">${c.years?.display || ''}</span>
                  <span class="text-cyan-400 font-bold font-mono">${c.chassisCodes ? 'Chasis: ' + c.chassisCodes : ''}</span>
                </div>
                <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors">
                  ${c.label}
                </h3>
                <p class="text-xs text-slate-400 mt-1 line-clamp-1">
                  ${c.class || 'Modelo ' + c.brandName}
                </p>
              </div>

              <div class="mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <a 
                  href="${c.brandCatalogUrl}" 
                  class="text-xs font-mono text-cyan-400 hover:text-cyan-300 flex items-center gap-1"
                >
                  <span>Ver en catálogo ${c.brandName}</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Listeners
    searchInput.addEventListener('input', (e) => {
      globalSearchQuery = e.target.value.trim();
      if (globalSearchQuery) {
        clearSearchBtn.classList.remove('hidden');
      } else {
        clearSearchBtn.classList.add('hidden');
      }
      renderGlobalCars();
    });

    clearSearchBtn.addEventListener('click', () => {
      searchInput.value = '';
      globalSearchQuery = '';
      clearSearchBtn.classList.add('hidden');
      renderGlobalCars();
      searchInput.focus();
    });

    eraSelect.addEventListener('change', (e) => {
      globalEra = e.target.value;
      if (globalEra === 'custom') {
        customYearsContainer.classList.remove('hidden');
      } else {
        customYearsContainer.classList.add('hidden');
      }
      renderGlobalCars();
    });

    applyYearsBtn.addEventListener('click', () => {
      globalCustomYearFrom = parseInt(yearFromInput.value, 10) || null;
      globalCustomYearTo = parseInt(yearToInput.value, 10) || null;
      renderGlobalCars();
    });

    conceptSelect.addEventListener('change', (e) => {
      globalConcept = e.target.value;
      renderGlobalCars();
    });

    sortSelect.addEventListener('change', (e) => {
      globalSort = e.target.value;
      renderGlobalCars();
    });

    function resetAllGlobal() {
      searchInput.value = '';
      globalSearchQuery = '';
      clearSearchBtn.classList.add('hidden');
      eraSelect.value = 'all';
      globalEra = 'all';
      conceptSelect.value = 'all';
      globalConcept = 'all';
      sortSelect.value = 'year-desc';
      globalSort = 'year-desc';
      customYearsContainer.classList.add('hidden');
      yearFromInput.value = '';
      yearToInput.value = '';
      globalCustomYearFrom = null;
      globalCustomYearTo = null;
      renderGlobalCars();
    }

    resetFiltersBtn.addEventListener('click', resetAllGlobal);
    emptyResetBtn.addEventListener('click', resetAllGlobal);

    // Render inicial
    renderGlobalCars();
  </script>
</Layout>
