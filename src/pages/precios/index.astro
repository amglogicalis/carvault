---
import Layout from '../../layouts/Layout.astro';
import bmwCatalog from '../../../data/bmw/catalog-clean-front.json';
import cupraCatalog from '../../../data/cupra/catalog-clean-front.json';
import { POPULAR_ENGINES_MAP as BMW_ENGINES_MAP } from '../../utils/bmw-engines';
import { CUPRA_ENGINES_MAP } from '../../utils/cupra-engines';

// Pasamos todos los modelos al buscador combinando BMW y CUPRA
const allGenerations = [
  ...bmwCatalog.generations.map(g => ({
    id: g.id,
    brand: 'BMW',
    label: g.label,
    series: g.series,
    section: g.section,
    years: g.years,
    class: g.class,
    chassis: g.chassis.map(c => c.code).filter(Boolean),
    variants: g.chassis.flatMap(c => c.variants || []),
    frontImage: g.frontImage?.url || null
  })),
  ...cupraCatalog.generations.map(g => ({
    id: g.id,
    brand: 'CUPRA',
    label: g.label,
    series: g.series,
    section: g.section,
    years: g.years,
    class: g.class,
    chassis: g.chassis.map(c => c.code).filter(Boolean),
    variants: g.chassis.flatMap(c => c.variants || []),
    frontImage: g.frontImage?.url || null
  }))
];

const modelsJson = JSON.stringify(allGenerations);
const enginesMapJson = JSON.stringify({ ...BMW_ENGINES_MAP, ...CUPRA_ENGINES_MAP });
---

<Layout title="Analizador Financiero de Precios & Suelo de Depreciación — Carvault" description="Motor cuantitativo multifactorial: nicho, prestaciones, carrocería, horizonte temporal a 20 años y cálculo de suelo de depreciación.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Algoritmo Multifactorial de Mercado v2.0
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Analizador de Precios, <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">Suelo & Revalorización</span>
      </h1>
      <p class="mt-3 text-slate-400 text-sm sm:text-base leading-relaxed">
        Calcula el ciclo de vida financiero de cualquier coche considerando su <strong>factor de nicho</strong>, prestaciones, tipo de carrocería y extras. Proyecta su cotización a <strong>5, 10 o 20 años</strong> vista.
      </p>
    </div>

    <!-- Buscador Reactivo y Controles de Simulación -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 backdrop-blur-md mb-8 max-w-4xl mx-auto shadow-2xl">
      <!-- Buscador -->
      <div class="mb-6">
        <label class="block text-xs font-mono text-slate-400 uppercase tracking-wider mb-2">1. Selecciona o escribe cualquier modelo (BMW o CUPRA):</label>
        <div class="relative">
          <input 
            id="carSearchInput"
            type="text" 
            placeholder="Escribe el modelo o versión (ej. Formentor VZ5, M3 E46, Born, 330ci, León VZ, M2 G87, Terramar...)" 
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-400 transition-colors font-mono"
          />
          <div id="searchResultsDropdown" class="absolute left-0 right-0 top-full mt-2 bg-slate-950 border border-slate-800 rounded-xl max-h-60 overflow-y-auto hidden z-30 shadow-2xl">
            <!-- Items dinámicos -->
          </div>
        </div>
      </div>

      <!-- Controles de Parámetros Dinámicos (Horizonte y Estado de Conservación) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-800/80">
        <!-- Horizonte Temporal -->
        <div>
          <label class="block text-[11px] font-mono text-slate-400 uppercase mb-1.5">Horizonte de Proyección</label>
          <select id="horizonSelect" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none focus:border-emerald-400">
            <option value="5">Próximos 5 Años</option>
            <option value="10" selected>Próximos 10 Años</option>
            <option value="15">Próximos 15 Años</option>
            <option value="20">Próximos 20 Años (Largo Plazo)</option>
          </select>
        </div>

        <!-- Estado de Conservación -->
        <div>
          <label class="block text-[11px] font-mono text-slate-400 uppercase mb-1.5">Estado del Vehículo</label>
          <select id="conditionSelect" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs text-slate-200 font-mono focus:outline-none focus:border-emerald-400">
            <option value="excellent">Excelente (Libro sellado / Colección)</option>
            <option value="good" selected>Buen estado (Mantenimiento al día)</option>
            <option value="average">Desgaste habitual / Kilometraje alto</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Estado Inicial: Invita a buscar un modelo -->
    <div id="preciosInitialState" class="text-center py-16 px-6 bg-slate-900/40 border border-slate-800 rounded-2xl max-w-xl mx-auto shadow-xl">
      <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto mb-3 text-2xl">
        📈
      </div>
      <h3 class="text-base font-bold text-white">Selecciona o escribe un modelo en el buscador</h3>
      <p class="text-xs text-slate-400 mt-2 max-w-md mx-auto leading-relaxed">
        El motor cuantitativo calculará su suelo de depreciación, cotización en España y Europa, y proyección financiera a 5, 10 o 20 años vista.
      </p>
    </div>

    <!-- Panel de Resultados del Análisis -->
    <div id="analysisPanel" class="hidden space-y-8 animate-fade-in">
      <!-- Ficha de Nicho & Perfil -->
      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-5 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <img id="profileCarImage" class="w-24 h-16 object-cover rounded-xl border border-slate-800 shadow-md hidden" alt="" />
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span id="profileBrandBadge" class="text-[10px] font-mono px-2 py-0.5 rounded border uppercase font-bold tracking-wider">-</span>
              <span class="text-xs font-mono text-slate-500 uppercase">Perfil Cuantitativo</span>
            </div>
            <h2 class="text-xl font-bold text-white" id="profileModelName">-</h2>
            <span class="text-xs text-slate-400 font-mono" id="profileCategory">-</span>
          </div>
        </div>
        <div class="flex items-center gap-6 text-xs font-mono">
          <div class="text-right">
            <span class="text-slate-500 block">Factor Nicho / Entusiasta</span>
            <span class="text-emerald-400 font-bold text-sm" id="nicheScoreText">-</span>
          </div>
          <div class="text-right">
            <span class="text-slate-500 block">MSRP Salida Estimado</span>
            <span class="text-slate-300 font-bold text-sm" id="profileMsrp">-</span>
          </div>
        </div>
      </div>

      <!-- Tarjetas de Métricas Clave -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Precio España Actual -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-slate-500 uppercase tracking-wider">Precio Hoy (España)</span>
            <div class="text-3xl font-black text-white font-mono mt-1" id="metricPriceSpain">-</div>
          </div>
          <span class="text-[11px] text-slate-400 mt-3 font-mono">Mercado nacional VO medio</span>
        </div>

        <!-- Precio Europa Actual -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-slate-500 uppercase tracking-wider">Precio Hoy (Europa)</span>
            <div class="text-3xl font-black text-cyan-400 font-mono mt-1" id="metricPriceEurope">-</div>
          </div>
          <span class="text-[11px] text-slate-400 mt-3 font-mono">Alemania & Centroeuropa</span>
        </div>

        <!-- Suelo de Depreciación -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-slate-500 uppercase tracking-wider">Suelo Histórico de Valor</span>
            <div class="text-3xl font-black text-amber-400 font-mono mt-1" id="metricTroughPrice">-</div>
          </div>
          <span class="text-[11px] text-slate-400 mt-3 font-mono" id="metricTroughYear">Mínimo en -</span>
        </div>

        <!-- Proyección Futura al Horizonte Elegido -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-slate-500 uppercase tracking-wider" id="metricProjectedHeader">Proyección Futura</span>
            <div class="text-3xl font-black text-emerald-400 font-mono mt-1" id="metricProjectedPrice">-</div>
          </div>
          <span class="text-[11px] text-slate-300 mt-3 font-mono" id="metricStatus">-</span>
        </div>
      </div>

      <!-- Veredicto del Algoritmo -->
      <div class="bg-gradient-to-r from-emerald-950/40 via-slate-900/80 to-slate-900/80 border border-emerald-500/30 rounded-2xl p-6">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center justify-center font-bold text-lg shrink-0">
            📊
          </div>
          <div>
            <h3 class="text-base font-bold text-white">Veredicto & Recomendación Cuantitativa</h3>
            <p class="text-sm text-slate-300 mt-1 leading-relaxed" id="verdictText"></p>
          </div>
        </div>
      </div>

      <!-- Gráfica Interactiva Ampliable -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
          <div>
            <h3 class="text-lg font-bold text-white">Curva de Depreciación & Horizonte Predictivo</h3>
            <p class="text-xs text-slate-400 mt-0.5">Evolución calculada año a año con proyección ampliable</p>
          </div>
          <div class="flex items-center gap-4 text-xs font-mono">
            <div class="flex items-center gap-1.5 text-slate-300">
              <span class="w-3 h-3 rounded-full bg-emerald-400"></span> España (EUR)
            </div>
            <div class="flex items-center gap-1.5 text-slate-400">
              <span class="w-3 h-3 rounded-full bg-cyan-400"></span> Europa (EUR)
            </div>
            <div class="flex items-center gap-1.5 text-amber-400">
              <span class="w-3 h-0.5 bg-amber-400 border-dashed"></span> Suelo de Depreciación
            </div>
          </div>
        </div>

        <div class="h-80 w-full relative">
          <canvas id="valuationChart"></canvas>
        </div>
      </div>

      <!-- Tabla de Datos Extensible -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 overflow-hidden">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-bold text-white font-mono uppercase">Historial Cronológico & Previsión Futura</h3>
          <span class="text-xs text-slate-500 font-mono" id="tableRowCount">Mostrando años</span>
        </div>
        <div class="overflow-x-auto max-h-96 border border-slate-800/80 rounded-xl">
          <table class="w-full text-left text-xs font-mono">
            <thead class="text-slate-400 border-b border-slate-800 sticky top-0 bg-slate-950">
              <tr>
                <th class="py-2.5 px-3">Año</th>
                <th class="py-2.5 px-3">Antigüedad</th>
                <th class="py-2.5 px-3">Cotización España</th>
                <th class="py-2.5 px-3">Cotización Europa</th>
                <th class="py-2.5 px-3">Hito / Fase</th>
              </tr>
            </thead>
            <tbody id="valuationTableBody" class="divide-y divide-slate-800/60 text-slate-300">
              <!-- Filas -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Disclaimer Legal & Técnico -->
      <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 text-[11px] text-slate-500 leading-relaxed font-mono">
        <span class="text-amber-400 font-bold block mb-0.5">⚠️ Nota de Precisión y Metodología:</span>
        Este modelo cuantitativo se basa en curvas logarítmicas y estadísticas observadas en el mercado de automoción europeo (diferenciales de España vs Alemania). Los valores son estimaciones orientativas y pueden verse afectados por el kilometraje, número de propietarios, estado mecánico verificado, color de carrocería, caja manual frente a automática, modas pasajeras o cambios regulatorios de emisiones (etiquetas medioambientales).
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script is:inline define:vars={{ modelsJson, enginesMapJson }}>
    const allModels = JSON.parse(modelsJson);
    const enginesMap = JSON.parse(enginesMapJson);
    let chartInstance = null;
    let selectedModel = null;
    let selectedEngineVariant = null;

    const searchInput = document.getElementById('carSearchInput');
    const dropdown = document.getElementById('searchResultsDropdown');
    const analysisPanel = document.getElementById('analysisPanel');
    const preciosInitialState = document.getElementById('preciosInitialState');
    const horizonSelect = document.getElementById('horizonSelect');
    const conditionSelect = document.getElementById('conditionSelect');

    function getCarTitle(m, engineVariant) {
      if (!engineVariant) return m.label;
      const brand = m.brand || 'BMW';
      if (brand === 'CUPRA') {
        return engineVariant.toLowerCase().startsWith('cupra')
          ? engineVariant
          : `CUPRA ${engineVariant}`;
      } else {
        return engineVariant.toLowerCase().startsWith('bmw')
          ? engineVariant
          : `BMW ${engineVariant} (${m.chassis[0] || m.label})`;
      }
    }

    function analyzeProfile(m, engineVariant) {
      const brand = m.brand || 'BMW';
      const lbl = m.label.toLowerCase();
      const ser = (m.series || '').toLowerCase();
      const eng = (engineVariant || '').toLowerCase();

      let nicheType = 'Berlina / Compacto Convencional';
      let nicheScore = 5;
      let troughAge = 18;
      let troughResidualRatio = 0.12;
      let appreciationRate = 0.02;
      let baseMsrp = 42000;

      if (brand === 'CUPRA') {
        // Modelos y Conceptos de CUPRA
        if (m.section === 'prototype' || /concept|darkrebel|urbanrebel/i.test(lbl)) {
          nicheType = 'Prototipo de Exhibición / Showcar IAA';
          nicheScore = 10;
          troughAge = 6;
          troughResidualRatio = 0.75;
          appreciationRate = 0.05;
          baseMsrp = 250000;
        } else if (eng.includes('vz5') || lbl.includes('vz5')) {
          // CUPRA Formentor VZ5 (2.5 TSI 5 cilindros Audi Sport, 7.000 unidades)
          nicheType = 'Icono Halo / Edición Limitada 5-Cilindros (VZ5)';
          nicheScore = 9;
          troughAge = 11;
          troughResidualRatio = 0.44;
          appreciationRate = 0.055;
          baseMsrp = 72000;
        } else if (
          (eng.includes('vz') && (eng.includes('300') || eng.includes('310') || eng.includes('333') || eng.includes('265') || eng.includes('tsi'))) ||
          (/ateca/i.test(lbl) && (eng.includes('300') || eng.includes('special') || eng.includes('limited') || !eng))
        ) {
          nicheType = 'Deportivo Hot Hatch / Crossover VZ';
          nicheScore = 7.5;
          troughAge = 14;
          troughResidualRatio = 0.25;
          appreciationRate = 0.035;
          baseMsrp = /formentor|terramar/i.test(lbl) ? 54000 : /ateca/i.test(lbl) ? 52000 : 48000;
        } else if (eng.includes('vz') && (eng.includes('hybrid') || eng.includes('245') || eng.includes('272'))) {
          nicheType = 'Deportivo Híbrido Enchufable PHEV (VZ e-HYBRID)';
          nicheScore = 6.5;
          troughAge = 15;
          troughResidualRatio = 0.21;
          appreciationRate = 0.025;
          baseMsrp = /formentor|terramar/i.test(lbl) ? 53000 : 46000;
        } else if (/born|tavascan|raval/i.test(lbl) || eng.includes('kwh') || eng.includes('endurance')) {
          const isTopVZ = eng.includes('vz') || eng.includes('340') || eng.includes('326');
          if (isTopVZ) {
            nicheType = 'Deportivo 100% Eléctrico VZ (High-Performance BEV)';
            nicheScore = 7;
            troughAge = 12;
            troughResidualRatio = 0.23;
            appreciationRate = 0.025;
            baseMsrp = /tavascan/i.test(lbl) ? 66000 : /born/i.test(lbl) ? 46000 : 36000;
          } else {
            nicheType = 'Compacto / Crossover 100% Eléctrico (BEV)';
            nicheScore = 6;
            troughAge = 13;
            troughResidualRatio = 0.19;
            appreciationRate = 0.02;
            baseMsrp = /tavascan/i.test(lbl) ? 54000 : /born/i.test(lbl) ? 41000 : 29000;
          }
        } else {
          // Modelos CUPRA estándar (TSI, eTSI, TDI, e-HYBRID)
          if (eng.includes('tdi') || eng.includes('diésel') || eng.includes('diesel')) {
            nicheType = 'Crossover Turbodiésel (TDI)';
            nicheScore = 5;
            troughAge = 17;
            troughResidualRatio = 0.15;
            appreciationRate = 0.018;
            baseMsrp = 39000;
          } else if (eng.includes('hybrid') || eng.includes('híbrido')) {
            nicheType = 'Crossover Híbrido Enchufable (e-HYBRID CERO)';
            nicheScore = 6;
            troughAge = 16;
            troughResidualRatio = 0.18;
            appreciationRate = 0.02;
            baseMsrp = 44000;
          } else {
            nicheType = 'Crossover / Compacto Deportivo Moderno';
            nicheScore = 5;
            troughAge = 16;
            troughResidualRatio = 0.16;
            appreciationRate = 0.022;
            baseMsrp = /terramar/i.test(lbl) ? 43000 : /formentor/i.test(lbl) ? 38000 : /ateca/i.test(lbl) ? 41000 : 34000;
          }
        }
      } else {
        // Modelos de BMW
        const isPureM = m.section === 'm-performance' || /\bm[1-8]\b|\b1m\b/i.test(lbl);
        const isRoadster = /roadster|z3|z4|z8|z1|spyder|cabrio/i.test(lbl) || /z series/i.test(ser);
        const isCoupe = /coup[eé]|csl|gt|2 series|4 series|8 series/i.test(lbl);
        const isSuv = /\bx[1-7]\b|sav|sac|suv/i.test(lbl) || /x series/i.test(ser);

        if (/z8/i.test(lbl) || /m1\b/i.test(lbl) || /csl/i.test(lbl)) {
          nicheType = 'Icono de Colección / Blue-Chip';
          nicheScore = 10;
          troughAge = 10;
          troughResidualRatio = 0.65;
          appreciationRate = 0.08;
          baseMsrp = 135000;
        } else if (isPureM) {
          if (/m2|1m/i.test(lbl)) {
            nicheType = 'Deportivo de Culto (M Compacto)';
            nicheScore = 9;
            troughAge = 13;
            troughResidualRatio = 0.38;
            appreciationRate = 0.06;
            baseMsrp = 66000;
          } else if (/m3|m4/i.test(lbl)) {
            nicheType = 'Referente Deportivo de Nicho (M3/M4)';
            nicheScore = 9;
            troughAge = 14;
            troughResidualRatio = 0.35;
            appreciationRate = 0.055;
            baseMsrp = 88000;
          } else if (/m5|m6/i.test(lbl)) {
            nicheType = 'Superberlina / Gran Turismo M';
            nicheScore = 8;
            troughAge = 15;
            troughResidualRatio = 0.28;
            appreciationRate = 0.045;
            baseMsrp = 118000;
          } else {
            nicheType = 'SUV de Altas Prestaciones M';
            nicheScore = 7;
            troughAge = 14;
            troughResidualRatio = 0.24;
            appreciationRate = 0.035;
            baseMsrp = 130000;
          }
        } else if (isRoadster) {
          nicheType = 'Roadster / Descapotable Entusiasta';
          nicheScore = 8;
          troughAge = 15;
          troughResidualRatio = 0.22;
          appreciationRate = 0.04;
          baseMsrp = 48000;
        } else if (isCoupe) {
          nicheType = 'Coupé Gran Turismo / Deportivo';
          nicheScore = 7;
          troughAge = 16;
          troughResidualRatio = 0.18;
          appreciationRate = 0.035;
          baseMsrp = 52000;
        } else if (isSuv) {
          nicheType = 'SUV / Crossover de Gran Consumo';
          nicheScore = 4;
          troughAge = 16;
          troughResidualRatio = 0.11;
          appreciationRate = 0.015;
          baseMsrp = 58000;
        } else {
          if (/1 Series/i.test(ser)) baseMsrp = 32000;
          else if (/3 Series/i.test(ser)) baseMsrp = 44000;
          else if (/5 Series/i.test(ser)) baseMsrp = 62000;
          else if (/7 Series/i.test(ser)) baseMsrp = 105000;
        }

        // Calibración por motorización específica BMW
        if (engineVariant) {
          if (eng.includes('335i') || eng.includes('340i') || eng.includes('135i') || eng.includes('140i') || eng.includes('540i') || eng.includes('550i')) {
            baseMsrp = Math.round(baseMsrp * 1.35);
            nicheScore = Math.min(10, nicheScore + 2);
            appreciationRate += 0.015;
            troughResidualRatio += 0.06;
            nicheType += ` (${engineVariant} 6L/V8 Top)`;
          } else if (eng.includes('330ci') || eng.includes('330i') || eng.includes('328i') || eng.includes('130i') || eng.includes('530i')) {
            baseMsrp = Math.round(baseMsrp * 1.22);
            nicheScore = Math.min(10, nicheScore + 1);
            appreciationRate += 0.01;
            troughResidualRatio += 0.04;
            nicheType += ` (${engineVariant} 6L Gasolina)`;
          } else if (eng.includes('320i') || eng.includes('325i') || eng.includes('525i')) {
            baseMsrp = Math.round(baseMsrp * 1.05);
            nicheType += ` (${engineVariant})`;
          } else if (eng.includes('320d') || eng.includes('330d') || eng.includes('530d')) {
            baseMsrp = Math.round(baseMsrp * 1.08);
            nicheType += ` (${engineVariant} Turbodiésel)`;
          } else {
            nicheType += ` (${engineVariant})`;
          }
        }
      }

      return { nicheType, nicheScore, troughAge, troughResidualRatio, appreciationRate, baseMsrp };
    }

    function calculateFullValuation(m, engineVariant) {
      const currentYear = 2026;
      const startYear = m.years.start || 2012;
      const horizon = parseInt(horizonSelect.value, 10) || 10;
      const condition = conditionSelect.value;

      const profile = analyzeProfile(m, engineVariant);

      let conditionFactor = 1.0;
      if (condition === 'excellent') conditionFactor = 1.22;
      else if (condition === 'average') conditionFactor = 0.85;

      const adjustedMsrp = profile.baseMsrp;
      const effectiveTrough = profile.troughResidualRatio * conditionFactor;

      const history = [];
      const maxYear = currentYear + horizon;
      let minPrice = Infinity;
      let minYear = startYear;

      for (let y = startYear; y <= maxYear; y++) {
        const age = y - startYear;
        let priceRatio;

        if (age <= profile.troughAge) {
          const k = 0.21;
          priceRatio = effectiveTrough + (conditionFactor - effectiveTrough) * Math.exp(-k * age);
        } else {
          const yearsPost = age - profile.troughAge;
          priceRatio = effectiveTrough * Math.pow(1 + profile.appreciationRate, yearsPost);
        }

        const priceBase = Math.round(adjustedMsrp * priceRatio);
        const priceSpain = Math.round(priceBase * 1.06);

        if (priceBase < minPrice) {
          minPrice = priceBase;
          minYear = y;
        }

        history.push({
          year: y,
          age,
          priceSpain,
          priceEurope: priceBase,
          isProjected: y > currentYear
        });
      }

      const cur = history.find(h => h.year === currentYear) || history[history.length - 1];
      const target = history.find(h => h.year === maxYear) || history[history.length - 1];
      const ageNow = currentYear - startYear;

      let status = 'Depreciación en Curso';
      let verdict = '';

      if (ageNow < 3) {
        status = 'Vehículo Seminuevo';
        verdict = `Fase de mayor amortización inicial (~15-20% anual). Por su configuración de ${profile.nicheType}, alcanzará mayor estabilidad de cotización en los próximos años.`;
      } else if (Math.abs(ageNow - profile.troughAge) <= 2) {
        status = '¡En Suelo de Depreciación!';
        verdict = `¡VENTANA HISTÓRICA ÓPTIMA! Con un índice de nicho de ${profile.nicheScore}/10 (${profile.nicheType}), este modelo ha alcanzado su suelo residual. Riesgo de depreciación casi nulo a partir de este punto.`;
      } else if (ageNow > profile.troughAge + 2) {
        status = 'Revalorizándose (Ciclo Alcista)';
        verdict = `ACTIVO EN APRECIACIÓN. Por ser un ${profile.nicheType}, la escasez de ejemplares bien mantenidos está provocando una subida progresiva de cotización en el mercado europeo.`;
      } else {
        status = 'Depreciación en Curso';
        verdict = `En curva de amortización estándar de segunda mano. Se estima que su suelo de valor llegará aproximadamente hacia el año ${minYear}.`;
      }

      return {
        profile,
        adjustedMsrp,
        cur,
        target,
        maxYear,
        minYear,
        minPrice,
        status,
        verdict,
        history
      };
    }

    function updateView() {
      if (!selectedModel) return;
      const data = calculateFullValuation(selectedModel, selectedEngineVariant);

      const displayTitle = getCarTitle(selectedModel, selectedEngineVariant);

      document.getElementById('profileModelName').textContent = displayTitle;
      document.getElementById('profileCategory').textContent = `${data.profile.nicheType} • ${selectedModel.class || ''}`;
      document.getElementById('nicheScoreText').textContent = `${data.profile.nicheScore}/10`;
      document.getElementById('profileMsrp').textContent = `${data.adjustedMsrp.toLocaleString()} €`;

      const imgEl = document.getElementById('profileCarImage');
      if (selectedModel.frontImage) {
        imgEl.src = selectedModel.frontImage;
        imgEl.alt = selectedModel.label;
        imgEl.classList.remove('hidden');
      } else {
        imgEl.classList.add('hidden');
      }

      const badgeEl = document.getElementById('profileBrandBadge');
      const isCupra = selectedModel.brand === 'CUPRA';
      badgeEl.textContent = selectedModel.brand || 'BMW';
      badgeEl.className = isCupra 
        ? 'text-[10px] font-mono px-2 py-0.5 rounded border uppercase bg-amber-500/10 text-amber-400 border-amber-500/20 font-bold tracking-wider'
        : 'text-[10px] font-mono px-2 py-0.5 rounded border uppercase bg-sky-500/10 text-sky-400 border-sky-500/20 font-bold tracking-wider';

      document.getElementById('metricPriceSpain').textContent = `${data.cur.priceSpain.toLocaleString()} €`;
      document.getElementById('metricPriceEurope').textContent = `${data.cur.priceEurope.toLocaleString()} €`;
      document.getElementById('metricTroughPrice').textContent = `${data.minPrice.toLocaleString()} €`;
      document.getElementById('metricTroughYear').textContent = `Mínimo hacia ${data.minYear}`;

      document.getElementById('metricProjectedHeader').textContent = `Proyección en ${data.maxYear}`;
      document.getElementById('metricProjectedPrice').textContent = `${data.target.priceSpain.toLocaleString()} €`;
      document.getElementById('metricStatus').textContent = data.status;

      document.getElementById('verdictText').textContent = data.verdict;

      // Tabla
      document.getElementById('tableRowCount').textContent = `${data.history.length} años analizados (${data.history[0].year} – ${data.maxYear})`;
      const tbody = document.getElementById('valuationTableBody');
      tbody.innerHTML = data.history.map(h => `
        <tr class="${h.year === 2026 ? 'bg-emerald-950/40 text-emerald-300 font-bold' : h.isProjected ? 'text-cyan-400/90 italic' : ''}">
          <td class="py-2 px-3">${h.year} ${h.isProjected ? '(Previsión)' : ''}</td>
          <td class="py-2 px-3">${h.age} años</td>
          <td class="py-2 px-3">${h.priceSpain.toLocaleString()} €</td>
          <td class="py-2 px-3">${h.priceEurope.toLocaleString()} €</td>
          <td class="py-2 px-3">${h.year === data.minYear ? '⭐ SUELO' : h.year === 2026 ? '📍 HOY' : h.isProjected ? 'Futuro' : 'Histórico'}</td>
        </tr>
      `).join('');

      renderChart(data);
      if (preciosInitialState) preciosInitialState.classList.add('hidden');
      analysisPanel.classList.remove('hidden');
    }

    function renderChart(data) {
      const ctx = document.getElementById('valuationChart').getContext('2d');
      if (chartInstance) chartInstance.destroy();

      const labels = data.history.map(h => h.year);
      const pricesSpain = data.history.map(h => h.priceSpain);
      const pricesEurope = data.history.map(h => h.priceEurope);

      chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'España (€)',
              data: pricesSpain,
              borderColor: '#10b981',
              backgroundColor: 'rgba(16, 185, 129, 0.08)',
              fill: true,
              tension: 0.35,
              pointRadius: labels.map(y => y === 2026 || y === data.minYear ? 6 : 2),
              pointBackgroundColor: labels.map(y => y === 2026 ? '#38bdf8' : y === data.minYear ? '#fbbf24' : '#10b981')
            },
            {
              label: 'Europa (€)',
              data: pricesEurope,
              borderColor: '#06b6d4',
              borderDash: [5, 5],
              tension: 0.35,
              pointRadius: 0
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: {
              grid: { color: 'rgba(255,255,255,0.05)' },
              ticks: { color: '#94a3b8', font: { family: 'JetBrains Mono' } }
            },
            y: {
              grid: { color: 'rgba(255,255,255,0.05)' },
              ticks: { 
                color: '#94a3b8', 
                font: { family: 'JetBrains Mono' },
                callback: v => `${(v/1000).toFixed(0)}k €` 
              }
            }
          }
        }
      });
    }

    function selectCar(m, engineVariant = null) {
      selectedModel = m;
      selectedEngineVariant = engineVariant;
      searchInput.value = getCarTitle(m, engineVariant);
      dropdown.classList.add('hidden');
      updateView();
    }

    // Reactividad a cambios en controles
    horizonSelect.addEventListener('change', updateView);
    conditionSelect.addEventListener('change', updateView);

    // Normalizador de texto en español (elimina acentos y convierte "serie" a "series")
    function normalizeSearch(text) {
      return (text || '').toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/\bserie\b/g, 'series')
        .trim();
    }

    // Buscador Tokenizado Inteligente
    searchInput.addEventListener('input', (e) => {
      const q = normalizeSearch(e.target.value);
      if (!q) {
        dropdown.classList.add('hidden');
        return;
      }

      const qTokens = q.split(/\s+/).filter(Boolean);
      const matches = [];

      for (const m of allModels) {
        const chassisList = m.chassis || [];
        const engines = [];
        for (const c of chassisList) {
          if (enginesMap[c]) engines.push(...enginesMap[c]);
        }
        if (m.variants && m.variants.length) {
          engines.push(...m.variants);
        }
        const uniqueEngines = Array.from(new Set(engines));

        const brand = m.brand || 'BMW';
        const allSearchable = [
          brand,
          m.label,
          brand + ' ' + m.label,
          m.series,
          ...chassisList,
          ...uniqueEngines
        ].map(s => normalizeSearch(s));

        const matchesAll = qTokens.every(tok =>
          allSearchable.some(item => item.includes(tok))
        );

        if (matchesAll) {
          // Detectar si coincidió con una motorización concreta
          const matchedEngine = uniqueEngines.find(eng => {
            const engNorm = normalizeSearch(eng);
            return qTokens.some(tok => tok === engNorm);
          }) || uniqueEngines.find(eng => {
            const engNorm = normalizeSearch(eng);
            return qTokens.some(tok => tok.length >= 2 && engNorm.includes(tok) && !normalizeSearch(m.label).includes(tok));
          });

          matches.push({
            model: m,
            engine: matchedEngine || null
          });
        }
      }

      const topMatches = matches.slice(0, 10);

      if (!topMatches.length) {
        dropdown.innerHTML = `<div class="p-3 text-xs text-slate-500 font-mono">No se encontraron modelos o motorizaciones coincidentes</div>`;
      } else {
        dropdown.innerHTML = topMatches.map(({ model: m, engine }) => {
          const brand = m.brand || 'BMW';
          const isCupra = brand === 'CUPRA';
          const title = getCarTitle(m, engine);
          const subtitle = engine 
            ? `${m.label} • ${m.years?.display || ''}` 
            : `${m.years?.display || ''} • ${(m.chassis || []).join(', ')}`;
          const badgeClass = isCupra 
            ? 'bg-amber-500/10 text-amber-400 border-amber-500/20' 
            : 'bg-sky-500/10 text-sky-400 border-sky-500/20';

          return `
            <div class="search-item p-3 hover:bg-slate-900 cursor-pointer flex items-center justify-between border-b border-slate-900 last:border-0 transition-colors" data-id="${m.id}" data-engine="${engine || ''}">
              <div class="flex items-center gap-3">
                <span class="text-[10px] font-bold px-2 py-0.5 rounded border ${badgeClass} font-mono uppercase tracking-wider shrink-0">
                  ${brand}
                </span>
                <div>
                  <span class="text-sm font-bold text-white">${title}</span>
                  <span class="text-xs text-slate-500 font-mono block">${subtitle}</span>
                </div>
              </div>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-800 text-emerald-400 shrink-0">Analizar ➔</span>
            </div>
          `;
        }).join('');

        dropdown.querySelectorAll('.search-item').forEach(item => {
          item.addEventListener('click', () => {
            const m = allModels.find(x => x.id === item.dataset.id);
            const eng = item.dataset.engine || null;
            if (m) selectCar(m, eng);
          });
        });
      }

      dropdown.classList.remove('hidden');
    });

    // Sin carga hardcodeada inicial: el buscador permanece limpio a la espera de la búsqueda del usuario
  </script>
</Layout>
