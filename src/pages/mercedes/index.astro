---
import Layout from '../../layouts/Layout.astro';
import catalog from '../../../data/mercedes/catalog-clean-front.json';

const totalGenerations = catalog.generations.length;
const totalChassis = catalog.stats.chassis || totalGenerations;
const totalAMG = catalog.generations.filter((g: any) => 
  g.section === 'm-performance' || 
  /amg|black series|dtm|one|slr|sls|m139|m156|m177|m178|m157|m113/i.test(g.label) || 
  /amg/i.test(g.series || '')
).length;
const modelsJson = JSON.stringify(catalog.generations);
---

<Layout title="Carvault — Catálogo y API Pública de Automóviles (Mercedes-Benz Edition)">
  <!-- Hero Section con paleta Silver Arrow / Flechas Plateadas & Cromo de Mercedes-Benz -->
  <section class="relative overflow-hidden pt-16 pb-20 border-b border-slate-900 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-800/40 via-slate-950 to-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <a href="/carvault/#marcas" class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-mono font-medium border border-slate-400/30 bg-slate-900/60 hover:bg-slate-800/60 text-slate-200 hover:text-white hover:border-slate-300/50 transition-colors mb-6 shadow-sm">
        <span>← Marcas Disponibles</span>
        <span class="text-slate-600">•</span>
        <span class="text-slate-100 font-bold">Mercedes-Benz</span>
      </a>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-tight">
        Catálogo Completo <span class="bg-gradient-to-r from-slate-100 via-slate-300 to-zinc-400 bg-clip-text text-transparent">Mercedes-Benz</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Colección integral automotriz con diferenciación cronológica estricta entre versiones <strong class="text-white">Pre-Facelift</strong> y <strong class="text-slate-200">MoPf (Modellpflege / Restyling)</strong>, leyendas eternas como el <strong class="text-white">300 SL Gullwing</strong> y el <strong class="text-white">190 E Evo II</strong>, la supremacía deportiva de <strong class="text-slate-200">Mercedes-AMG</strong> (SLS, AMG GT, Black Series, Hypercar ONE), el lujo supremo de las <strong class="text-white">Clase S y Maybach</strong>, el icónico <strong class="text-white">Clase G</strong> y la innovación 100% eléctrica <strong class="text-cyan-400">Mercedes-EQ</strong> con vistas frontales 100% verificadas.
      </p>

      <!-- Métricas rápidas de la marca -->
      <div class="mt-8 flex flex-wrap justify-center gap-6 sm:gap-12 text-slate-300">
        <div class="flex flex-col items-center">
          <span class="text-3xl font-black text-white font-mono">{totalGenerations}</span>
          <span class="text-xs text-slate-400 uppercase tracking-wider mt-1">Modelos & Versiones</span>
        </div>
        <div class="h-10 w-[1px] bg-slate-800 hidden sm:block"></div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-black text-slate-200 font-mono">{totalAMG}</span>
          <span class="text-xs text-slate-400 uppercase tracking-wider mt-1">Mercedes-AMG & Iconos</span>
        </div>
        <div class="h-10 w-[1px] bg-slate-800 hidden sm:block"></div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-black text-slate-300 font-mono">{totalChassis}</span>
          <span class="text-xs text-slate-400 uppercase tracking-wider mt-1">Chasis & Códigos (W/S/C/X/R)</span>
        </div>
        <div class="h-10 w-[1px] bg-slate-800 hidden sm:block"></div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-black text-cyan-400 font-mono">{catalog.stats.withExactFront || totalGenerations}</span>
          <span class="text-xs text-slate-400 uppercase tracking-wider mt-1">Frontales con Foto (100%)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Catálogo Interactivo -->
  <section id="catalog" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Panel Principal de Búsqueda y Filtros Multifactoriales -->
    <div class="bg-slate-900/80 p-5 sm:p-6 rounded-3xl border border-slate-800 backdrop-blur-md mb-8 shadow-2xl space-y-6">
      <!-- 1. Buscador Principal con Atajo y Sugerencias -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="searchInput" class="text-xs font-mono text-slate-400 uppercase tracking-wider flex items-center gap-2">
            <span>Búsqueda Inteligente</span>
            <span class="text-[10px] text-slate-500 font-sans hidden sm:inline">(300 SL, C 63, AMG GT, 190 E, E 55, S 600, W204, W124, G 63, MoPf...)</span>
          </label>
          <span class="hidden sm:inline-block text-[11px] font-mono text-slate-500">Pulsa <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700 text-[10px]">/</kbd> para buscar</span>
        </div>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <input 
            id="searchInput"
            type="text" 
            placeholder="Escribe para buscar... (ej: 300 SL, C 63 AMG, AMG GT R, SLS, W124 500 E, S 600 V12, G 63, EQS, W205, W223...)" 
            class="w-full bg-slate-950 border border-slate-700/80 rounded-xl pl-10 pr-10 py-3 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-slate-300 focus:ring-1 focus:ring-slate-300/40 transition-all font-mono"
            autocomplete="off"
          />
          <button 
            id="clearSearchBtn" 
            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-500 hover:text-slate-300 transition-colors hidden cursor-pointer"
            title="Limpiar búsqueda"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>

      <!-- 2. Filtros Específicos por Gama / División Mercedes -->
      <div>
        <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-2 flex items-center gap-2">
          <span>División / Carrocería:</span>
        </div>
        <div class="flex flex-wrap gap-1.5" id="seriesFilters">
          <button class="filter-series-btn px-3 py-1.5 rounded-lg text-xs font-mono border transition-all cursor-pointer bg-slate-200/20 text-slate-100 border-slate-300/40 font-bold" data-series="all">Todas ({totalGenerations})</button>
          <button class="filter-series-btn px-3 py-1.5 rounded-lg text-xs font-mono border transition-all cursor-pointer bg-slate-950/60 text-slate-400 border-slate-800 hover:text-white" data-series="amg">Mercedes-AMG & Black Series ({totalAMG})</button>
          <button class="filter-series-btn px-3 py-1.5 rounded-lg text-xs font-mono border transition-all cursor-pointer bg-slate-950/60 text-slate-400 border-slate-800 hover:text-white" data-series="sedans">Berlinas (Clase A, C, E, S, CLA, CLS)</button>
          <button class="filter-series-btn px-3 py-1.5 rounded-lg text-xs font-mono border transition-all cursor-pointer bg-slate-950/60 text-slate-400 border-slate-800 hover:text-white" data-series="sport">Deportivos & SL (SL, AMG GT, SLS, SLR, CLK)</button>
          <button class="filter-series-btn px-3 py-1.5 rounded-lg text-xs font-mono border transition-all cursor-pointer bg-slate-950/60 text-slate-400 border-slate-800 hover:text-white" data-series="suv">Clase G & SUVs (G, GLC, GLE, GLS)</button>
          <button class="filter-series-btn px-3 py-1.5 rounded-lg text-xs font-mono border transition-all cursor-pointer bg-slate-950/60 text-slate-400 border-slate-800 hover:text-white" data-series="eq">Mercedes-EQ (100% Eléctrico)</button>
        </div>
      </div>

      <!-- 3. Filtros Técnicos Avanzados: Restylings (MoPf vs Pre-Facelift) y Propulsión -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-3 border-t border-slate-800/80">
        <!-- Filtro Restyling / Facelift (MoPf) -->
        <div>
          <label class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-2">Restyling (MoPf / Facelift):</label>
          <div class="flex flex-wrap gap-1.5" id="faceliftFilters">
            <button class="filter-facelift-btn px-2.5 py-1 rounded-md text-xs font-mono border transition-all cursor-pointer bg-slate-300 text-slate-950 border-slate-300 font-bold" data-facelift="all">Todos</button>
            <button class="filter-facelift-btn px-2.5 py-1 rounded-md text-xs font-mono border transition-all cursor-pointer bg-slate-950/60 text-slate-400 border-slate-800 hover:text-white" data-facelift="mopf">Solo MoPf / Restyling</button>
            <button class="filter-facelift-btn px-2.5 py-1 rounded-md text-xs font-mono border transition-all cursor-pointer bg-slate-950/60 text-slate-400 border-slate-800 hover:text-white" data-facelift="pre-facelift">Solo Pre-Facelift</button>
          </div>
        </div>

        <!-- Filtro Tipo de Motorización / Combustible -->
        <div>
          <label class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-2">Motorización / Propulsión:</label>
          <div class="flex flex-wrap gap-1.5" id="fuelFilters">
            <button class="filter-fuel-btn px-2.5 py-1 rounded-md text-xs font-mono border transition-all cursor-pointer bg-slate-300 text-slate-950 border-slate-300 font-bold" data-fuel="all">Todas</button>
            <button class="filter-fuel-btn px-2.5 py-1 rounded-md text-xs font-mono border transition-all cursor-pointer bg-slate-950/60 text-slate-400 border-slate-800 hover:text-white" data-fuel="gasolina">Gasolina</button>
            <button class="filter-fuel-btn px-2.5 py-1 rounded-md text-xs font-mono border transition-all cursor-pointer bg-slate-950/60 text-slate-400 border-slate-800 hover:text-white" data-fuel="diesel">Diésel</button>
            <button class="filter-fuel-btn px-2.5 py-1 rounded-md text-xs font-mono border transition-all cursor-pointer bg-slate-950/60 text-slate-400 border-slate-800 hover:text-white" data-fuel="hibrido">Híbrido / PHEV</button>
            <button class="filter-fuel-btn px-2.5 py-1 rounded-md text-xs font-mono border transition-all cursor-pointer bg-slate-950/60 text-slate-400 border-slate-800 hover:text-white" data-fuel="electrico">100% Eléctrico</button>
          </div>
        </div>

        <!-- Acceso directo a Herramientas Especializadas -->
        <div>
          <label class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-2">Herramientas Especializadas:</label>
          <div class="flex flex-wrap gap-2">
            <a href="/carvault/motores/" class="px-2.5 py-1 rounded-md text-xs font-mono bg-slate-950/60 border border-slate-800 hover:border-cyan-500/50 text-cyan-400 hover:text-cyan-300 transition-colors flex items-center gap-1.5">
              <span>⚡ Comparador Motores</span>
            </a>
            <a href="/carvault/precios/" class="px-2.5 py-1 rounded-md text-xs font-mono bg-slate-950/60 border border-slate-800 hover:border-emerald-500/50 text-emerald-400 hover:text-emerald-300 transition-colors flex items-center gap-1.5">
              <span>💰 Motor de Precios</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Barra de Estado Activo y Contador de Resultados -->
      <div class="flex items-center justify-between text-xs font-mono text-slate-400 pt-3 border-t border-slate-800/80">
        <div class="flex items-center gap-2">
          <span>Mostrando:</span>
          <span id="filteredCount" class="font-bold text-slate-200">{totalGenerations}</span>
          <span>de {totalGenerations} modelos</span>
        </div>
        <button id="resetAllFiltersBtn" class="text-slate-400 hover:text-white underline underline-offset-4 cursor-pointer hidden">
          Restablecer todos los filtros
        </button>
      </div>
    </div>

    <!-- Grid de Coches -->
    <div id="carsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      <!-- Renderizado reactivo desde script client-side -->
    </div>

    <!-- Mensaje Estado Vacío -->
    <div id="emptyState" class="hidden text-center py-20 px-4 bg-slate-900/40 rounded-3xl border border-slate-800">
      <div class="w-16 h-16 mx-auto rounded-full bg-slate-800 flex items-center justify-center text-slate-400 text-2xl mb-4">
        🔍
      </div>
      <h3 class="text-xl font-bold text-white mb-2">No se encontraron modelos con los filtros actuales</h3>
      <p class="text-sm text-slate-400 max-w-md mx-auto mb-6">
        Intenta relajar los términos de búsqueda o restablecer los filtros de categoría y restyling.
      </p>
      <button id="resetEmptyBtn" class="px-5 py-2.5 rounded-xl bg-slate-200 text-slate-950 font-bold text-xs font-mono hover:bg-white transition-all cursor-pointer">
        Restablecer todos los filtros
      </button>
    </div>
  </section>

  <!-- Lightbox Pantalla Completa para Fotografías Frontales -->
  <div id="imageLightbox" class="fixed inset-0 z-50 bg-black/95 backdrop-blur-xl hidden flex items-center justify-center p-4 sm:p-8 animate-fade-in">
    <button id="closeLightboxBtn" class="absolute top-5 right-5 z-20 p-3 rounded-full bg-slate-800/80 hover:bg-red-500/80 text-white transition-all shadow-xl hover:scale-110 flex items-center justify-center cursor-pointer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <div class="relative max-w-6xl max-h-[90vh] w-full flex flex-col items-center justify-center">
      <img id="lightboxImg" src="" alt="Vista frontal ampliada" class="max-h-[80vh] max-w-full object-contain rounded-xl shadow-2xl border border-slate-800/80" />
      <div class="mt-4 text-center">
        <h4 id="lightboxTitle" class="text-white font-bold text-base sm:text-lg"></h4>
        <p id="lightboxSubtitle" class="text-xs font-mono text-slate-400 mt-1"></p>
      </div>
    </div>
  </div>

  <!-- JSON embebido con datos del catálogo -->
  <script id="catalogData" type="application/json" set:html={modelsJson}></script>

  <!-- Lógica Reactiva Client-Side -->
  <script is:inline>
    (function() {
      const dataElement = document.getElementById('catalogData');
      if (!dataElement) return;
      const allModels = JSON.parse(dataElement.textContent || '[]');

      const searchInput = document.getElementById('searchInput');
      const clearSearchBtn = document.getElementById('clearSearchBtn');
      const carsGrid = document.getElementById('carsGrid');
      const emptyState = document.getElementById('emptyState');
      const filteredCount = document.getElementById('filteredCount');
      const resetAllFiltersBtn = document.getElementById('resetAllFiltersBtn');
      const resetEmptyBtn = document.getElementById('resetEmptyBtn');

      // Estado activo de los filtros
      let currentQuery = '';
      let activeSeries = 'all';
      let activeFacelift = 'all';
      let activeFuel = 'all';

      // Atajo de teclado "/" para enfocar buscador
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== searchInput) {
          e.preventDefault();
          searchInput.focus();
        } else if (e.key === 'Escape') {
          closeLightbox();
        }
      });

      // Renderizador de tarjeta de modelo
      function renderModelCard(model) {
        const imgUrl = model.frontImage?.url || '/images/placeholder-car.svg';
        const imgAuthor = model.frontImage?.author || 'Wikimedia Commons';
        const imgLicense = model.frontImage?.license || 'CC BY-SA';
        const isMoPf = /mopf|facelift|restyling/i.test(model.label) || /mopf/i.test(model.chassis?.[0]?.code || '');
        const isPre = /pre-facelift|pre-mopf/i.test(model.label);
        const isAMG = model.section === 'm-performance' || /amg|black series|dtm|one/i.test(model.label);

        // Ficha técnica del primer motor o motor insignia
        const mainEngine = model.engines?.[0];
        const engineBadge = mainEngine ? `${mainEngine.powerHp} CV • ${mainEngine.engineCode || mainEngine.architecture}` : '';
        const accelBadge = mainEngine?.accel0to100 ? `${mainEngine.accel0to100}s (0-100)` : '';

        return `
          <article class="car-card bg-slate-900/90 border border-slate-800 hover:border-slate-400/50 rounded-3xl overflow-hidden transition-all duration-300 flex flex-col hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-slate-500/10 group" data-id="${model.id}">
            <!-- Contenedor Fotografía Frontal -->
            <div class="relative aspect-[16/10] bg-slate-950 overflow-hidden cursor-zoom-in" onclick="openLightbox('${imgUrl}', '${escapeHtml(model.label)}', '${escapeHtml(model.class || '')}')">
              <img 
                src="${imgUrl}" 
                alt="${escapeHtml(model.label)}"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-60"></div>
              
              <!-- Badges Superpuestos -->
              <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                ${isAMG ? '<span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-950 text-[10px] font-mono font-black shadow-md">AMG</span>' : ''}
                ${isMoPf ? '<span class="px-2 py-0.5 rounded-md bg-cyan-500/90 text-slate-950 text-[10px] font-mono font-bold shadow-md">MoPf (Restyling)</span>' : ''}
                ${isPre ? '<span class="px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 text-[10px] font-mono border border-slate-700 shadow-md">Pre-Facelift</span>' : ''}
              </div>

              <div class="absolute bottom-2 right-3 text-[10px] font-mono text-slate-400 bg-slate-950/80 px-2 py-0.5 rounded backdrop-blur-sm">
                ${model.years?.display || ''}
              </div>
            </div>

            <!-- Información del Vehículo -->
            <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-1">
                  <span>${model.series || 'Mercedes-Benz'}</span>
                  <span class="text-slate-300 font-bold">${model.chassis?.[0]?.code || ''}</span>
                </div>
                <h3 class="text-lg font-bold text-white group-hover:text-slate-200 transition-colors">
                  ${escapeHtml(model.label)}
                </h3>
                <p class="text-xs text-slate-400 mt-1 line-clamp-2 leading-relaxed">
                  ${escapeHtml(model.class || '')}
                </p>
              </div>

              <!-- Motor y Especificaciones -->
              ${mainEngine ? `
                <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono">
                  <div class="flex items-center gap-1.5 text-slate-200 font-semibold">
                    <span>⚡</span>
                    <span>${engineBadge}</span>
                  </div>
                  ${accelBadge ? `<span class="text-cyan-400">${accelBadge}</span>` : ''}
                </div>
              ` : ''}

              <!-- Créditos de imagen y enlaces -->
              <div class="pt-2 text-[10px] font-mono text-slate-400 flex items-center justify-between">
                <span>Foto: ${escapeHtml(imgAuthor)} (${escapeHtml(imgLicense)})</span>
                <a href="${model.frontImage?.sourceUrl || '#'}" target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-white underline">
                  Commons ↗
                </a>
              </div>
            </div>
          </article>
        `;
      }

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      // Filtrado y renderizado
      function filterAndRender() {
        const q = currentQuery.toLowerCase().trim();

        const filtered = allModels.filter(m => {
          // 1. Filtro por texto
          if (q) {
            const chassisCodes = (m.chassis || []).map(c => c.code).join(' ');
            const engineBadges = (m.engines || []).map(e => `${e.modelBadge} ${e.engineCode} ${e.architecture}`).join(' ');
            const text = `${m.label} ${m.series} ${m.class} ${chassisCodes} ${engineBadges}`.toLowerCase();
            if (!text.includes(q)) return false;
          }

          // 2. Filtro por División / Saga
          if (activeSeries !== 'all') {
            const lbl = (m.label || '').toLowerCase();
            const srs = (m.series || '').toLowerCase();
            const cls = (m.class || '').toLowerCase();

            if (activeSeries === 'amg') {
              const isAMG = m.section === 'm-performance' || /amg|black series|dtm|one|slr|sls/i.test(lbl);
              if (!isAMG) return false;
            } else if (activeSeries === 'sedans') {
              const isSedan = /clase a|clase c|clase e|clase s|cla|cls|190/i.test(srs) || /berlina|limusina/i.test(cls);
              if (!isSedan) return false;
            } else if (activeSeries === 'sport') {
              const isSport = /sl|amg gt|sls|slr|clk|cle|roadster/i.test(srs) || /deportivo|superdeportivo|roadster|gullwing/i.test(cls);
              if (!isSport) return false;
            } else if (activeSeries === 'suv') {
              const isSuv = /clase g|glc|gle|gls|clase m/i.test(srs) || /suv|todoterreno|geländewagen/i.test(cls);
              if (!isSuv) return false;
            } else if (activeSeries === 'eq') {
              const isEQ = /eq|eléctrico/i.test(srs) || /eq|eléctrico/i.test(lbl) || (m.engines && m.engines.some(e => e.fuel === 'Eléctrico'));
              if (!isEQ) return false;
            }
          }

          // 3. Filtro por Restyling (MoPf)
          if (activeFacelift !== 'all') {
            const isMoPf = /mopf|facelift|restyling/i.test(m.label) || /mopf/i.test(m.chassis?.[0]?.code || '');
            const isPre = /pre-facelift|pre-mopf/i.test(m.label);
            if (activeFacelift === 'mopf' && !isMoPf) return false;
            if (activeFacelift === 'pre-facelift' && !isPre) return false;
          }

          // 4. Filtro por Motor / Combustible
          if (activeFuel !== 'all') {
            const engines = m.engines || [];
            if (activeFuel === 'gasolina' && !engines.some(e => e.fuel === 'Gasolina')) return false;
            if (activeFuel === 'diesel' && !engines.some(e => e.fuel === 'Diésel')) return false;
            if (activeFuel === 'hibrido' && !engines.some(e => e.fuel === 'Híbrido' || e.fuel === 'Híbrido Enchufable')) return false;
            if (activeFuel === 'electrico' && !engines.some(e => e.fuel === 'Eléctrico')) return false;
          }

          return true;
        });

        // Actualizar UI
        filteredCount.textContent = filtered.length;
        if (filtered.length === 0) {
          carsGrid.innerHTML = '';
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
          carsGrid.innerHTML = filtered.map(renderModelCard).join('');
        }

        // Mostrar botón de reset si hay filtros activos
        const hasActiveFilters = currentQuery !== '' || activeSeries !== 'all' || activeFacelift !== 'all' || activeFuel !== 'all';
        if (hasActiveFilters) {
          resetAllFiltersBtn.classList.remove('hidden');
        } else {
          resetAllFiltersBtn.classList.add('hidden');
        }
      }

      // Handlers de búsqueda
      searchInput.addEventListener('input', (e) => {
        currentQuery = e.target.value;
        if (currentQuery) {
          clearSearchBtn.classList.remove('hidden');
        } else {
          clearSearchBtn.classList.add('hidden');
        }
        filterAndRender();
      });

      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentQuery = '';
        clearSearchBtn.classList.add('hidden');
        searchInput.focus();
        filterAndRender();
      });

      // Handlers de botones de serie
      document.querySelectorAll('.filter-series-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.filter-series-btn').forEach(b => {
            b.classList.remove('bg-slate-200/20', 'text-slate-100', 'border-slate-300/40', 'font-bold');
            b.classList.add('bg-slate-950/60', 'text-slate-400', 'border-slate-800');
          });
          btn.classList.add('bg-slate-200/20', 'text-slate-100', 'border-slate-300/40', 'font-bold');
          btn.classList.remove('bg-slate-950/60', 'text-slate-400', 'border-slate-800');
          activeSeries = btn.dataset.series || 'all';
          filterAndRender();
        });
      });

      // Handlers de botones de restyling
      document.querySelectorAll('.filter-facelift-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.filter-facelift-btn').forEach(b => {
            b.classList.remove('bg-slate-300', 'text-slate-950', 'border-slate-300', 'font-bold');
            b.classList.add('bg-slate-950/60', 'text-slate-400', 'border-slate-800');
          });
          btn.classList.add('bg-slate-300', 'text-slate-950', 'border-slate-300', 'font-bold');
          btn.classList.remove('bg-slate-950/60', 'text-slate-400', 'border-slate-800');
          activeFacelift = btn.dataset.facelift || 'all';
          filterAndRender();
        });
      });

      // Handlers de botones de combustible
      document.querySelectorAll('.filter-fuel-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.filter-fuel-btn').forEach(b => {
            b.classList.remove('bg-slate-300', 'text-slate-950', 'border-slate-300', 'font-bold');
            b.classList.add('bg-slate-950/60', 'text-slate-400', 'border-slate-800');
          });
          btn.classList.add('bg-slate-300', 'text-slate-950', 'border-slate-300', 'font-bold');
          btn.classList.remove('bg-slate-950/60', 'text-slate-400', 'border-slate-800');
          activeFuel = btn.dataset.fuel || 'all';
          filterAndRender();
        });
      });

      // Reset total
      function resetAll() {
        searchInput.value = '';
        currentQuery = '';
        clearSearchBtn.classList.add('hidden');
        activeSeries = 'all';
        activeFacelift = 'all';
        activeFuel = 'all';

        document.querySelector('.filter-series-btn[data-series="all"]')?.click();
        document.querySelector('.filter-facelift-btn[data-facelift="all"]')?.click();
        document.querySelector('.filter-fuel-btn[data-fuel="all"]')?.click();
      }

      resetAllFiltersBtn.addEventListener('click', resetAll);
      resetEmptyBtn?.addEventListener('click', resetAll);

      // Lightbox logic
      const lightbox = document.getElementById('imageLightbox');
      const lightboxImg = document.getElementById('lightboxImg');
      const lightboxTitle = document.getElementById('lightboxTitle');
      const lightboxSubtitle = document.getElementById('lightboxSubtitle');
      const closeLightboxBtn = document.getElementById('closeLightboxBtn');

      window.openLightbox = function(url, title, subtitle) {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.src = url;
        if (lightboxTitle) lightboxTitle.textContent = title;
        if (lightboxSubtitle) lightboxSubtitle.textContent = subtitle;
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      };

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
      }

      closeLightboxBtn?.addEventListener('click', closeLightbox);
      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      // Render inicial
      filterAndRender();
    })();
  </script>
</Layout>
