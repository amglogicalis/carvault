---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
}

const { 
  title = "Carvault — Every car, from every angle", 
  description = "Modern open catalog and public API for automotive models across 4 perspectives.",
  lang = "es"
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/carvault/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      code, pre, .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-100 selection:bg-cyan-500/30 selection:text-cyan-300">
    <!-- Navbar moderna -->
    <header class="sticky top-0 z-50 backdrop-blur-xl bg-slate-950/80 border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/carvault/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-slate-900/90 border border-cyan-500/30 flex items-center justify-center p-1.5 shadow-lg shadow-cyan-500/20 group-hover:scale-105 group-hover:border-cyan-400 transition-all">
            <img src="/carvault/logo.svg" alt="Carvault Logo" class="w-full h-full object-contain filter drop-shadow-[0_0_8px_rgba(6,182,212,0.6)]" />
          </div>
          <div>
            <span class="text-lg font-bold tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
              CARVAULT
            </span>
            <span class="block text-[10px] tracking-wider uppercase text-cyan-400/90 font-mono">
              Open Auto Catalog
            </span>
          </div>
        </a>

        <nav class="flex items-center gap-6 text-sm font-medium">
          <a href="/carvault/" class="text-slate-300 hover:text-cyan-400 transition-colors">
            Home
          </a>
          <a href="/carvault/#marcas" class="text-slate-300 hover:text-cyan-400 transition-colors">
            Marcas
          </a>

          <!-- Desplegable Catálogo con Buscador y Marcas Disponibles -->
          <div class="relative group/catalog" id="navCatalogDropdownContainer">
            <button 
              id="navCatalogBtn" 
              class="text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-1.5 cursor-pointer py-2 focus:outline-none"
              aria-expanded="false"
              aria-haspopup="true"
            >
              <span>Catálogo</span>
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/catalog:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <!-- Menú Desplegable Flotante -->
            <div 
              id="navCatalogMenu" 
              class="absolute left-0 top-full pt-1.5 hidden group-hover/catalog:block z-50 w-72 animate-fade-in"
            >
              <div class="bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-3 backdrop-blur-xl space-y-2.5">
                <!-- Buscador de marcas dentro del desplegable -->
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-500">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                  </div>
                  <input 
                    type="text" 
                    id="navBrandSearchInput" 
                    placeholder="Filtrar catálogo de marca..." 
                    class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-8 pr-2.5 py-1.5 text-xs text-slate-200 font-mono placeholder:text-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400/40"
                  />
                </div>

                <!-- Lista de Marcas con Catálogo Disponible -->
                <div class="space-y-1 max-h-60 overflow-y-auto" id="navBrandsList">
                  <a 
                    href="/carvault/bmw" 
                    class="nav-brand-item flex items-center justify-between p-2 rounded-xl bg-slate-950/60 hover:bg-slate-800/80 border border-slate-850 hover:border-cyan-500/40 transition-all group"
                    data-brand="bmw"
                  >
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-full bg-slate-900 border border-slate-800 p-1 flex items-center justify-center shrink-0">
                        <img src="/carvault/images/brands/bmw.svg" alt="BMW" class="w-full h-full object-contain" />
                      </div>
                      <div>
                        <div class="text-xs font-bold text-white group-hover:text-cyan-300 transition-colors">BMW</div>
                        <div class="text-[10px] text-slate-500 font-mono">200 modelos • Gama M</div>
                      </div>
                    </div>
                    <span class="text-[10px] font-mono font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-1.5 py-0.5 rounded">Activo</span>
                  </a>

                  <!-- Próximas marcas (visibles como referencia informativa en el dropdown) -->
                  <div class="nav-brand-item flex items-center justify-between p-2 rounded-xl bg-slate-950/30 border border-transparent opacity-50 cursor-not-allowed" data-brand="porsche">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center shrink-0 font-bold text-xs text-slate-500">P</div>
                      <div>
                        <div class="text-xs font-semibold text-slate-400">Porsche</div>
                        <div class="text-[10px] text-slate-600 font-mono">Stuttgart</div>
                      </div>
                    </div>
                    <span class="text-[9px] font-mono text-slate-500">Pronto</span>
                  </div>

                  <div class="nav-brand-item flex items-center justify-between p-2 rounded-xl bg-slate-950/30 border border-transparent opacity-50 cursor-not-allowed" data-brand="mercedes">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center shrink-0 font-bold text-[10px] text-slate-500">MB</div>
                      <div>
                        <div class="text-xs font-semibold text-slate-400">Mercedes-Benz</div>
                        <div class="text-[10px] text-slate-600 font-mono">Stuttgart</div>
                      </div>
                    </div>
                    <span class="text-[9px] font-mono text-slate-500">Pronto</span>
                  </div>
                </div>

                <!-- Pie del dropdown -->
                <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between text-[11px] font-mono text-slate-500 px-1">
                  <span>1 catálogo activo</span>
                  <a href="/carvault/#marcas" class="text-cyan-400 hover:underline">Ver todas →</a>
                </div>
              </div>
            </div>
          </div>

          <a href="/carvault/motores" class="text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-1.5 font-semibold">
            <span class="inline-block w-2 h-2 rounded-full bg-cyan-400"></span>
            Motores & Fases
          </a>
          <a href="/carvault/precios" class="text-slate-300 hover:text-emerald-400 transition-colors flex items-center gap-1.5 font-semibold text-emerald-400">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
            Precios & Suelo
          </a>
          <a id="navApiLink" href="/carvault/#api" class="text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-cyan-400"></span>
            API Pública
          </a>
          <div class="h-4 w-[1px] bg-slate-800"></div>
          <button id="langToggle" class="px-2.5 py-1 rounded-md text-xs font-mono font-medium border border-slate-700 bg-slate-900/80 text-slate-300 hover:text-white hover:border-slate-500 transition-colors">
            ES / EN
          </button>
          <a 
            href="https://github.com/amglogicalis/carvault" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 transition-all flex items-center gap-2"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-900 bg-slate-950 py-12 text-slate-500 text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <p class="text-slate-400 font-semibold text-sm">Carvault • Open Automotive Database & Visual Vault</p>
          <p class="mt-1">Imágenes y datos bajo licencias Wikimedia Commons (CC-BY / CC-BY-SA) y Wikidata (CC0). Sin afiliación oficial con BMW AG.</p>
        </div>
        <div class="flex items-center gap-4 flex-wrap">
          <a href="/carvault/api/v1/carvault.json" class="text-cyan-400 hover:underline font-mono">/api/v1/carvault.json</a>
          <span>•</span>
          <a href="/carvault/api/v1/bmw.json" class="text-slate-400 hover:text-white hover:underline font-mono">/api/v1/bmw.json</a>
          <span>•</span>
          <span>Desarrollado bajo el ecosistema Terra</span>
        </div>
      </div>
    </footer>

    <!-- Script Global de Navegación (Desplegable y Enlace Contextual de API) -->
    <script is:inline>
      // 1. Filtrado en el buscador del desplegable de Catálogo
      const brandSearch = document.getElementById('navBrandSearchInput');
      const brandItems = document.querySelectorAll('.nav-brand-item');
      if (brandSearch) {
        brandSearch.addEventListener('input', (e) => {
          const q = e.target.value.toLowerCase().trim();
          brandItems.forEach(item => {
            const brand = (item.getAttribute('data-brand') || '').toLowerCase();
            const text = item.textContent.toLowerCase();
            if (!q || brand.includes(q) || text.includes(q)) {
              item.style.display = 'flex';
            } else {
              item.style.display = 'none';
            }
          });
        });
      }

      // 2. Control de enlace "API Pública" según la página actual
      const navApiLink = document.getElementById('navApiLink');
      if (navApiLink) {
        const path = window.location.pathname;
        if (path.includes('/bmw')) {
          // En la sección monomarca de BMW, abre la API específica de BMW
          navApiLink.href = '/carvault/api/v1/bmw.json';
          navApiLink.target = '_blank';
          navApiLink.title = 'Abrir JSON específico de BMW';
        } else {
          // En Home u otras páginas, abre el gateway general de Carvault
          navApiLink.href = '/carvault/api/v1/carvault.json';
          navApiLink.target = '_blank';
          navApiLink.title = 'Abrir API Central Gateway de Carvault';
        }
      }
    </script>
  </body>
</html>
