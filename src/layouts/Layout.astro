---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
}

const { 
  title = "Carvault — Every car, from every angle", 
  description = "Modern open catalog and public API for automotive models across 4 perspectives.",
  lang = "es"
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      code, pre, .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-100 selection:bg-cyan-500/30 selection:text-cyan-300">
    <!-- Navbar moderna -->
    <header class="sticky top-0 z-50 backdrop-blur-xl bg-slate-950/80 border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center font-bold text-slate-950 shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform">
            CV
          </div>
          <div>
            <span class="text-lg font-bold tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
              CARVAULT
            </span>
            <span class="block text-[10px] tracking-wider uppercase text-cyan-400/90 font-mono">
              Open Auto Catalog
            </span>
          </div>
        </a>

        <nav class="flex items-center gap-6 text-sm font-medium">
          <a href="/#marcas" class="text-slate-300 hover:text-cyan-400 transition-colors">
            Marcas
          </a>
          <a href="/bmw" class="text-slate-300 hover:text-cyan-400 transition-colors">
            Catálogo BMW
          </a>
          <a href="/precios" class="text-slate-300 hover:text-emerald-400 transition-colors flex items-center gap-1.5 font-semibold text-emerald-400">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
            Precios & Suelo
          </a>
          <a href="/#api" class="text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-cyan-400"></span>
            API Pública
          </a>
          <div class="h-4 w-[1px] bg-slate-800"></div>
          <button id="langToggle" class="px-2.5 py-1 rounded-md text-xs font-mono font-medium border border-slate-700 bg-slate-900/80 text-slate-300 hover:text-white hover:border-slate-500 transition-colors">
            ES / EN
          </button>
          <a 
            href="https://github.com/amglogicalis/carvault" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 transition-all flex items-center gap-2"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-900 bg-slate-950 py-12 text-slate-500 text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <p class="text-slate-400 font-semibold text-sm">Carvault • Open Automotive Database & Visual Vault</p>
          <p class="mt-1">Imágenes y datos bajo licencias Wikimedia Commons (CC-BY / CC-BY-SA) y Wikidata (CC0). Sin afiliación oficial con BMW AG.</p>
        </div>
        <div class="flex items-center gap-4 flex-wrap">
          <a href="/api/v1/carvault.json" class="text-cyan-400 hover:underline font-mono">/api/v1/carvault.json</a>
          <span>•</span>
          <a href="/api/v1/bmw.json" class="text-slate-400 hover:text-white hover:underline font-mono">/api/v1/bmw.json</a>
          <span>•</span>
          <span>Desarrollado bajo el ecosistema Terra</span>
        </div>
      </div>
    </footer>
  </body>
</html>
